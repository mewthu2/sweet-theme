{% doc %}
  Renders the desktop mega menu panel for a top-level menu link.
  Layout and featured content come from an optional header "mega_menu" block.

  @param {object} link - The top-level menu link
  @param {object} [block] - The matching mega_menu block from the header section
  @param {string} panel_id - Unique id for the panel element
  @param {number} [tab_products] - Products per tab in the tabs layout

  @example
  {% render 'mega-menu', link: link, block: mega, panel_id: 'MegaMenu-1' %}
{% enddoc %}

{%- liquid
  assign layout = 'tabs'
  assign featured = 'none'
  assign products_limit = 3
  assign show_footer = true
  assign button_label = 'header.shop_title' | t: title: link.title
  if block
    assign layout = block.settings.layout
    assign featured = block.settings.featured
    assign products_limit = block.settings.products_limit
    assign show_footer = block.settings.show_footer
    if block.settings.button_label != blank
      assign button_label = block.settings.button_label
    endif
  endif

  assign tab_products = tab_products | default: 8

  assign has_collections = false
  for child in link.links
    if child.type == 'collection_link'
      assign has_collections = true
      break
    endif
  endfor
  if layout == 'tabs' and has_collections == false
    assign layout = 'columns'
  endif

  assign has_grandchildren = false
  for child in link.links
    if child.links != blank
      assign has_grandchildren = true
      break
    endif
  endfor

  assign has_promos = false
  if featured == 'promos'
    if block.settings.promo_1_heading != blank or block.settings.promo_1_image != blank
      assign has_promos = true
    endif
    if block.settings.promo_2_heading != blank or block.settings.promo_2_image != blank
      assign has_promos = true
    endif
  endif

  assign has_products = false
  if featured == 'products' and block.settings.collection != blank
    if block.settings.collection.products_count > 0
      assign has_products = true
    endif
  endif

  assign column_count = link.links.size | at_most: 5 | at_least: 1
-%}

<div
  class="mega-menu mega-menu--{{ layout }}"
  id="{{ panel_id }}"
  {% if block %}
    data-block-id="{{ block.id }}" {{ block.shopify_attributes }}
  {% endif %}
>
  {%- if layout == 'tabs' -%}
    <div class="mega-menu__inner">
      <div class="mega-menu__tabs" role="tablist" data-tab-hover>
        {%- for child in link.links -%}
          <a
            href="{{ child.url }}"
            role="tab"
            id="{{ panel_id }}-tab-{{ forloop.index }}"
            aria-controls="{{ panel_id }}-panel-{{ forloop.index }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            class="mega-menu__tab"
          >
            {{- child.title -}}
          </a>
        {%- endfor -%}
      </div>

      {%- for child in link.links -%}
        <div
          class="mega-menu__tab-panel"
          role="tabpanel"
          id="{{ panel_id }}-panel-{{ forloop.index }}"
          aria-labelledby="{{ panel_id }}-tab-{{ forloop.index }}"
          {% unless forloop.first %}
            hidden
          {% endunless %}
        >
          {%- if child.type == 'collection_link' and child.object.products_count > 0 -%}
            <div class="mega-menu__carousel" data-carousel>
              <ul class="mega-menu__track" role="list" data-carousel-track>
                {%- for product in child.object.products limit: tab_products -%}
                  <li class="mega-menu__slide">
                    {% render 'product-card', product: product, style: 'mini', sizes: '(min-width: 990px) 16vw, 25vw' %}
                  </li>
                {%- endfor -%}
              </ul>
              <button type="button" class="circle-button mega-menu__arrow mega-menu__arrow--prev" data-carousel-prev>
                {% render 'icon', name: 'arrow-left' %}
                <span class="visually-hidden">{{ 'general.previous' | t }}</span>
              </button>
              <button type="button" class="circle-button mega-menu__arrow mega-menu__arrow--next" data-carousel-next>
                {% render 'icon', name: 'arrow-right' %}
                <span class="visually-hidden">{{ 'general.next' | t }}</span>
              </button>
            </div>
          {%- elsif child.links != blank -%}
            <ul class="mega-menu__chips" role="list">
              {%- for grandchild in child.links -%}
                <li><a href="{{ grandchild.url }}" class="button">{{ grandchild.title }}</a></li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      {%- endfor -%}

      {%- if show_footer -%}
        <div class="mega-menu__actions">
          <a href="{{ link.url }}" class="button">{{ button_label }}</a>
        </div>
      {%- endif -%}
    </div>
  {%- else -%}
    <div class="mega-menu__inner mega-menu__inner--columns{% if has_promos or has_products %} has-featured{% endif %}">
      {%- if link.links != blank -%}
        <div class="mega-menu__nav">
          {%- if has_grandchildren -%}
            <div class="mega-menu__columns" style="--columns: {{ column_count }};">
              {%- for child in link.links -%}
                <div class="mega-menu__column">
                  <a href="{{ child.url }}" class="mega-menu__heading">{{ child.title }}</a>
                  {%- if child.links != blank -%}
                    <ul class="mega-menu__list" role="list">
                      {%- for grandchild in child.links -%}
                        <li>
                          <a
                            href="{{ grandchild.url }}"
                            class="mega-menu__link"
                            {% if grandchild.active %}
                              aria-current="page"
                            {% endif %}
                          >
                            {{- grandchild.title -}}
                          </a>
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </div>
              {%- endfor -%}
            </div>
          {%- else -%}
            <ul class="mega-menu__biglist" role="list">
              {%- for child in link.links -%}
                <li>
                  <a
                    href="{{ child.url }}"
                    class="mega-menu__biglink"
                    {% if child.active %}
                      aria-current="page"
                    {% endif %}
                  >
                    {{- child.title -}}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if has_promos -%}
        <div class="mega-menu__promos">
          {%- for i in (1..2) -%}
            {%- liquid
              assign image_key = 'promo_' | append: i | append: '_image'
              assign heading_key = 'promo_' | append: i | append: '_heading'
              assign text_key = 'promo_' | append: i | append: '_text'
              assign link_key = 'promo_' | append: i | append: '_link'
              assign promo_image = block.settings[image_key]
              assign promo_heading = block.settings[heading_key]
              assign promo_text = block.settings[text_key]
              assign promo_link = block.settings[link_key] | default: link.url
            -%}
            {%- if promo_image != blank or promo_heading != blank -%}
              <a href="{{ promo_link }}" class="mega-promo">
                <span class="mega-promo__media">
                  {%- if promo_image != blank -%}
                    {{
                      promo_image
                      | image_url: width: 800
                      | image_tag: class: 'mega-promo__image', widths: '300, 500, 800', sizes: '(min-width: 990px) 18vw, 50vw', loading: 'lazy', alt: promo_heading
                    }}
                  {%- else -%}
                    {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg mega-promo__image' }}
                  {%- endif -%}
                  <span class="mega-promo__text">
                    {%- if promo_heading != blank -%}
                      <span class="mega-promo__title">{{ promo_heading }}</span>
                    {%- endif -%}
                    {%- if promo_text != blank -%}
                      <span>{{ promo_text }}</span>
                    {%- endif -%}
                  </span>
                </span>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- elsif has_products -%}
        <ul class="mega-menu__products" role="list" style="--products: {{ products_limit }};">
          {%- for product in block.settings.collection.products limit: products_limit -%}
            <li>{% render 'product-card', product: product, style: 'mini', sizes: '(min-width: 990px) 14vw, 25vw' %}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if show_footer -%}
        <div class="mega-menu__actions">
          <a href="{{ link.url }}" class="button">{{ button_label }}</a>
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .mega-menu {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    border-radius: 0 0 var(--radius) var(--radius);
    background: var(--color-surface);
    color: var(--color-heading);
    clip-path: inset(0 0 100% 0);
    visibility: hidden;
    transition: clip-path 0.4s var(--ease), visibility 0s linear 0.4s;
  }

  .site-nav__item.is-open > .mega-menu {
    clip-path: inset(0 0 -1px 0);
    visibility: visible;
    transition: clip-path 0.45s var(--ease), visibility 0s;
  }

  .mega-menu__inner {
    display: grid;
    gap: 2.5rem;
    padding: 0.5rem clamp(1.5rem, 1rem + 2vw, 2rem) 2.25rem;
    opacity: 0;
    transform: translateY(-6px);
    transition: opacity 0.3s var(--ease), transform 0.3s var(--ease);
  }

  .site-nav__item.is-open .mega-menu__inner {
    opacity: 1;
    transform: none;
    transition-delay: 0.12s;
  }

  .mega-menu__tabs {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem 3rem;
  }

  .mega-menu__tab {
    padding-bottom: 0.4rem;
    border-bottom: 1px solid transparent;
    color: var(--color-muted);
    font-size: 1rem;
    font-weight: var(--font-bold--weight);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-decoration: none;
    opacity: 0.6;
    transition: color 0.2s var(--ease), opacity 0.2s var(--ease), border-color 0.2s var(--ease);
  }

  .mega-menu__tab:hover,
  .mega-menu__tab[aria-selected='true'] {
    color: var(--color-heading);
    opacity: 1;
  }

  .mega-menu__tab[aria-selected='true'] {
    border-color: currentcolor;
  }

  .mega-menu__tab-panel {
    animation: mega-fade 0.35s var(--ease);
  }

  .mega-menu__carousel {
    position: relative;
    width: min(100%, 64rem);
    margin-inline: auto;
  }

  .mega-menu__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 3rem) / 4);
    gap: 1rem;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .mega-menu__track::-webkit-scrollbar {
    display: none;
  }

  .mega-menu__slide {
    scroll-snap-align: start;
  }

  .mega-menu__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
  }

  .mega-menu__arrow:hover {
    transform: translateY(-50%) scale(1.05);
  }

  .mega-menu__arrow--prev {
    left: -4.5rem;
  }

  .mega-menu__arrow--next {
    right: -4.5rem;
  }

  .mega-menu__chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    padding: 0;
    list-style: none;
  }

  .mega-menu__actions {
    display: flex;
    justify-content: center;
    grid-column: 1 / -1;
  }

  .mega-menu__inner--columns {
    grid-template-columns: minmax(0, 1fr);
    padding-top: 1.5rem;
  }

  .mega-menu__inner--columns.has-featured {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
  }

  .mega-menu__columns {
    display: grid;
    grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
    gap: 2rem;
  }

  .mega-menu__heading {
    display: inline-block;
    margin-bottom: 1rem;
    font-weight: var(--font-bold--weight);
    text-transform: uppercase;
    text-decoration: none;
  }

  .mega-menu__list {
    display: grid;
    gap: 0.75rem;
    padding: 0;
    list-style: none;
  }

  .mega-menu__link {
    text-decoration: none;
    background: linear-gradient(currentcolor, currentcolor) 0 100% / 0 1px no-repeat;
    transition: background-size 0.3s var(--ease);
  }

  .mega-menu__link:hover,
  .mega-menu__link[aria-current] {
    background-size: 100% 1px;
  }

  .mega-menu__biglist {
    display: grid;
    padding: 0;
    list-style: none;
  }

  .mega-menu__biglink {
    display: block;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--color-border);
    font-size: clamp(1.25rem, 0.9rem + 0.8vw, 1.75rem);
    font-weight: var(--font-bold--weight);
    line-height: 1.2;
    text-decoration: none;
    text-transform: lowercase;
    opacity: 0.55;
    transition: opacity 0.2s var(--ease), padding 0.3s var(--ease);
  }

  .mega-menu__biglink:hover,
  .mega-menu__biglink[aria-current] {
    opacity: 1;
    padding-left: 0.5rem;
  }

  .mega-menu__promos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .mega-promo {
    display: block;
    color: #fff;
    text-decoration: none;
  }

  .mega-promo__media {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-small);
    background: var(--color-card);
  }

  .mega-promo__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease);
  }

  .mega-promo:hover .mega-promo__image {
    transform: scale(1.04);
  }

  .mega-promo__text {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: grid;
    gap: 0.15rem;
    padding: 1.25rem;
    background: linear-gradient(to top, rgb(0 0 0 / 0.35), transparent);
  }

  .mega-promo__title {
    font-weight: var(--font-bold--weight);
    text-transform: uppercase;
  }

  .mega-menu__products {
    display: grid;
    grid-template-columns: repeat(var(--products, 3), minmax(0, 1fr));
    gap: 1rem;
    padding: 0;
    list-style: none;
  }

  @keyframes mega-fade {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
  }
{% endstylesheet %}
