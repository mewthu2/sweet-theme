{% doc %}
  Renders the desktop mega menu panel for a top-level menu link.
  Layout and featured content come from an optional header "mega_menu" block.

  @param {object} link - The top-level menu link
  @param {object} [block] - The matching mega_menu block from the header section
  @param {string} panel_id - Unique id for the panel element
  @param {number} [tab_products] - Products per tab in the tabs layout

  @example
  {% render 'mega-menu', link: link, block: mega, panel_id: 'MegaMenu-1' %}
{% enddoc %}

{%- liquid
  assign layout = 'columns'
  assign featured = 'none'
  assign products_limit = 3
  assign show_footer = true
  if block
    assign layout = block.settings.layout
    assign featured = block.settings.featured
    assign products_limit = block.settings.products_limit
    assign show_footer = block.settings.show_footer
  endif

  assign tab_products = tab_products | default: 4

  assign has_grandchildren = false
  for child in link.links
    if child.links != blank
      assign has_grandchildren = true
      break
    endif
  endfor

  assign has_promos = false
  if featured == 'promos'
    if block.settings.promo_1_heading != blank or block.settings.promo_1_image != blank
      assign has_promos = true
    endif
    if block.settings.promo_2_heading != blank or block.settings.promo_2_image != blank
      assign has_promos = true
    endif
  endif

  assign has_products = false
  if featured == 'products' and block.settings.collection != blank
    if block.settings.collection.products_count > 0
      assign has_products = true
    endif
  endif

  assign column_count = link.links.size | at_most: 5 | at_least: 1
-%}

<div
  class="mega-menu mega-menu--{{ layout }}"
  id="{{ panel_id }}"
  {% if block %}
    data-block-id="{{ block.id }}" {{ block.shopify_attributes }}
  {% endif %}
>
  {%- if layout == 'tabs' and link.links != blank -%}
    <div class="mega-menu__inner mega-menu__inner--tabs">
      <div class="mega-menu__tabs" role="tablist" aria-orientation="vertical" data-tab-hover>
        {%- for child in link.links -%}
          <a
            href="{{ child.url }}"
            role="tab"
            id="{{ panel_id }}-tab-{{ forloop.index }}"
            aria-controls="{{ panel_id }}-panel-{{ forloop.index }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            class="mega-menu__tab"
            style="--i: {{ forloop.index0 }};"
          >
            {{- child.title -}}
          </a>
        {%- endfor -%}
      </div>

      {%- for child in link.links -%}
        <div
          class="mega-menu__tab-panel"
          role="tabpanel"
          id="{{ panel_id }}-panel-{{ forloop.index }}"
          aria-labelledby="{{ panel_id }}-tab-{{ forloop.index }}"
          {% unless forloop.first %}
            hidden
          {% endunless %}
        >
          {%- if child.type == 'collection_link' and child.object.products_count > 0 -%}
            <ul class="mega-menu__products" role="list" style="--products: {{ tab_products }};">
              {%- for product in child.object.products limit: tab_products -%}
                <li>{% render 'product-card', product: product, sizes: '(min-width: 990px) 16vw, 25vw' %}</li>
              {%- endfor -%}
            </ul>
          {%- elsif child.links != blank -%}
            <ul class="mega-menu__list mega-menu__list--large" role="list">
              {%- for grandchild in child.links -%}
                <li><a href="{{ grandchild.url }}" class="mega-menu__link">{{ grandchild.title }}</a></li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
          <a href="{{ child.url }}" class="mega-menu__more">
            {{- 'header.shop_title' | t: title: child.title -}}
            {% render 'icon', name: 'arrow-right' %}
          </a>
        </div>
      {%- endfor -%}
    </div>
  {%- else -%}
    <div class="mega-menu__inner mega-menu__inner--columns{% if has_promos or has_products %} has-featured{% endif %}">
      {%- if link.links != blank -%}
        <div class="mega-menu__nav">
          {%- if has_grandchildren -%}
            <div class="mega-menu__columns" style="--columns: {{ column_count }};">
              {%- for child in link.links -%}
                <div class="mega-menu__column" style="--i: {{ forloop.index0 }};">
                  <a href="{{ child.url }}" class="mega-menu__heading">{{ child.title }}</a>
                  {%- if child.links != blank -%}
                    <ul class="mega-menu__list" role="list">
                      {%- for grandchild in child.links -%}
                        <li>
                          <a
                            href="{{ grandchild.url }}"
                            class="mega-menu__link"
                            {% if grandchild.active %}
                              aria-current="page"
                            {% endif %}
                          >
                            {{- grandchild.title -}}
                          </a>
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </div>
              {%- endfor -%}
            </div>
          {%- else -%}
            <p class="mega-menu__eyebrow eyebrow">{{ link.title }}</p>
            <ul class="mega-menu__biglist" role="list">
              {%- for child in link.links -%}
                <li style="--i: {{ forloop.index0 }};">
                  <a
                    href="{{ child.url }}"
                    class="mega-menu__biglink"
                    {% if child.active %}
                      aria-current="page"
                    {% endif %}
                  >
                    <span>{{ child.title }}</span>
                    {% render 'icon', name: 'arrow-right' %}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if has_promos -%}
        <div class="mega-menu__featured mega-menu__promos">
          {%- for i in (1..2) -%}
            {%- liquid
              assign image_key = 'promo_' | append: i | append: '_image'
              assign heading_key = 'promo_' | append: i | append: '_heading'
              assign text_key = 'promo_' | append: i | append: '_text'
              assign link_key = 'promo_' | append: i | append: '_link'
              assign promo_image = block.settings[image_key]
              assign promo_heading = block.settings[heading_key]
              assign promo_text = block.settings[text_key]
              assign promo_link = block.settings[link_key] | default: link.url
            -%}
            {%- if promo_image != blank or promo_heading != blank -%}
              <a href="{{ promo_link }}" class="mega-promo" style="--i: {{ i | plus: 2 }};">
                <span class="mega-promo__media">
                  {%- if promo_image != blank -%}
                    {{
                      promo_image
                      | image_url: width: 800
                      | image_tag: class: 'mega-promo__image', widths: '300, 500, 800', sizes: '(min-width: 990px) 18vw, 50vw', loading: 'lazy', alt: promo_heading
                    }}
                  {%- else -%}
                    {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg mega-promo__image' }}
                  {%- endif -%}
                </span>
                {%- if promo_heading != blank -%}
                  <span class="mega-promo__title">
                    {{- promo_heading -}}
                    {% render 'icon', name: 'arrow-right' %}
                  </span>
                {%- endif -%}
                {%- if promo_text != blank -%}
                  <span class="mega-promo__text">{{ promo_text }}</span>
                {%- endif -%}
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- elsif has_products -%}
        <div class="mega-menu__featured">
          <p class="mega-menu__eyebrow eyebrow">{{ block.settings.collection.title }}</p>
          <ul class="mega-menu__products" role="list" style="--products: {{ products_limit }};">
            {%- for product in block.settings.collection.products limit: products_limit -%}
              <li>{% render 'product-card', product: product, sizes: '(min-width: 990px) 14vw, 25vw' %}</li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if show_footer -%}
    <div class="mega-menu__footer">
      <div class="mega-menu__footer-inner">
        <a href="{{ link.url }}" class="mega-menu__more">
          {{- 'header.view_all_in' | t: title: link.title -}}
          {% render 'icon', name: 'arrow-right' %}
        </a>
        {%- if block.settings.footer_text != blank -%}
          <span class="mega-menu__footer-text">{{ block.settings.footer_text }}</span>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .mega-menu {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--header-bg);
    color: var(--color-foreground);
    box-shadow: inset 0 1px 0 var(--color-border), 0 1px 0 var(--color-border);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition: opacity 0.28s var(--ease), transform 0.28s var(--ease), visibility 0s linear 0.28s;
  }

  .mega-menu::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    height: 100vh;
    background: var(--color-overlay);
    pointer-events: none;
  }

  .site-nav__item.is-open > .mega-menu {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition: opacity 0.28s var(--ease), transform 0.28s var(--ease), visibility 0s;
  }

  .mega-menu__inner {
    width: min(var(--page-width), 100%);
    margin-inline: auto;
    padding: 2.5rem var(--page-margin) 2.75rem;
  }

  .mega-menu__inner--columns {
    display: grid;
    gap: 3rem;
  }

  .mega-menu__inner--columns.has-featured {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
  }

  .mega-menu__inner--tabs {
    display: grid;
    grid-template-columns: 15rem minmax(0, 1fr);
    gap: 3rem;
  }

  .mega-menu__column,
  .mega-menu__biglist li,
  .mega-menu__tab,
  .mega-promo,
  .mega-menu__featured > * {
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.35s var(--ease), transform 0.35s var(--ease);
    transition-delay: 0s;
  }

  .site-nav__item.is-open .mega-menu__column,
  .site-nav__item.is-open .mega-menu__biglist li,
  .site-nav__item.is-open .mega-menu__tab,
  .site-nav__item.is-open .mega-promo,
  .site-nav__item.is-open .mega-menu__featured > * {
    opacity: 1;
    transform: none;
    transition-delay: calc(var(--i, 0) * 40ms + 60ms);
  }

  .mega-menu__eyebrow {
    margin-bottom: 1.25rem;
    color: var(--color-foreground);
  }

  .mega-menu__columns {
    display: grid;
    grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
    gap: 2rem;
  }

  .mega-menu__heading {
    display: inline-block;
    margin-bottom: 1rem;
    color: var(--color-heading);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .mega-menu__list {
    display: grid;
    gap: 0.6rem;
    padding: 0;
    list-style: none;
  }

  .mega-menu__list--large .mega-menu__link {
    font-size: 1.125rem;
  }

  .mega-menu__link {
    position: relative;
    color: var(--color-heading);
    font-size: 0.9375rem;
    text-decoration: none;
    text-transform: lowercase;
    background: linear-gradient(currentcolor, currentcolor) 0 100% / 0 1px no-repeat;
    transition: background-size 0.3s var(--ease);
  }

  .mega-menu__link:hover,
  .mega-menu__link[aria-current] {
    background-size: 100% 1px;
  }

  .mega-menu__biglist {
    display: grid;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-border);
  }

  .mega-menu__biglink {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.8rem;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-heading);
    font-family: var(--font-heading--family);
    font-size: clamp(1.25rem, 0.9rem + 0.8vw, 1.75rem);
    line-height: 1.2;
    text-decoration: none;
    text-transform: lowercase;
  }

  .mega-menu__biglink span {
    transition: transform 0.3s var(--ease);
  }

  .mega-menu__biglink .icon {
    opacity: 0;
    transform: translateX(-8px);
    transition: opacity 0.3s var(--ease), transform 0.3s var(--ease);
  }

  .mega-menu__biglink:hover span,
  .mega-menu__biglink[aria-current] span {
    transform: translateX(0.5rem);
  }

  .mega-menu__biglink:hover .icon {
    opacity: 1;
    transform: none;
  }

  .mega-menu__promos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .mega-promo {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    color: var(--color-heading);
    text-decoration: none;
  }

  .mega-promo__media {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    margin-bottom: 0.5rem;
    overflow: hidden;
    background: var(--color-surface);
  }

  .mega-promo__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease);
  }

  .mega-promo:hover .mega-promo__image {
    transform: scale(1.04);
  }

  .mega-promo__title {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .mega-promo__title .icon {
    width: 0.9rem;
    transition: transform 0.3s var(--ease);
  }

  .mega-promo:hover .mega-promo__title .icon {
    transform: translateX(4px);
  }

  .mega-promo__text {
    font-size: 0.8125rem;
    color: var(--color-foreground);
  }

  .mega-menu__products {
    display: grid;
    grid-template-columns: repeat(var(--products, 4), minmax(0, 1fr));
    gap: 1rem;
    padding: 0;
    list-style: none;
  }

  .mega-menu__tabs {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    border-right: 1px solid var(--color-border);
    padding-right: 2rem;
  }

  .mega-menu__tab {
    padding-block: 0.3rem;
    color: var(--color-foreground);
    font-family: var(--font-heading--family);
    font-size: 1.25rem;
    text-decoration: none;
    text-transform: lowercase;
    transition: color 0.2s var(--ease), padding 0.3s var(--ease);
  }

  .mega-menu__tab[aria-selected='true'] {
    color: var(--color-heading);
    padding-left: 0.75rem;
    box-shadow: inset 2px 0 0 var(--color-primary);
  }

  .mega-menu__tab-panel {
    display: grid;
    gap: 1.5rem;
    align-content: start;
    animation: mega-fade 0.35s var(--ease);
  }

  .mega-menu__more {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    justify-self: start;
    color: var(--color-heading);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .mega-menu__more .icon {
    width: 0.9rem;
    transition: transform 0.3s var(--ease);
  }

  .mega-menu__more:hover .icon {
    transform: translateX(4px);
  }

  .mega-menu__footer {
    background: var(--color-accent);
  }

  .mega-menu__footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: min(var(--page-width), 100%);
    min-height: 3rem;
    margin-inline: auto;
    padding: 0.75rem var(--page-margin);
  }

  .mega-menu__footer-text {
    color: var(--color-heading);
    font-size: 0.75rem;
  }

  @keyframes mega-fade {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
  }
{% endstylesheet %}
