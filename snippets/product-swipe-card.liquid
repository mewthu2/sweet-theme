{% doc %}
  Renders the large carousel product card with shade picker and a full-width
  "buy — price" button, inspired by editorial beauty storefronts.

  @param {product} product - The product to render
  @param {string} [label] - Small label shown above the image; defaults to the product type
  @param {string} [sizes] - The sizes attribute for the image

  @example
  {% render 'product-swipe-card', product: product %}
{% enddoc %}

{%- liquid
  assign sizes = sizes | default: '(min-width: 990px) 30vw, (min-width: 750px) 45vw, 85vw'
  assign label = label | default: product.type
  assign subtitle = product.metafields.custom.subtitle.value
  assign current = product.selected_or_first_available_variant
  assign first_option = product.options_with_values.first
  assign show_picker = false
  if product.options.size == 1 and product.has_only_default_variant == false and first_option.values.size <= 12
    assign show_picker = true
  endif
-%}

<article class="swipe-card" data-quick-buy>
  <div class="swipe-card__top">
    {%- if label != blank -%}
      <span class="swipe-card__label">{{ label | downcase }}</span>
    {%- endif -%}
    {% render 'product-badge', product: product %}
  </div>

  <a href="{{ product.url }}" class="swipe-card__media" aria-label="{{ product.title | escape }}">
    {%- if product.featured_media -%}
      {{
        product.featured_media.preview_image
        | image_url: width: 1200
        | image_tag: loading: 'lazy', sizes: sizes, widths: '400, 600, 800, 1000, 1200', class: 'swipe-card__image', alt: product.featured_media.alt
      }}
    {%- else -%}
      {{ 'product-2' | placeholder_svg_tag: 'placeholder-svg swipe-card__image' }}
    {%- endif -%}
  </a>

  <div class="swipe-card__body">
    <div class="swipe-card__heading">
      <h3 class="swipe-card__title product-title-case">
        <a href="{{ product.url }}">{{ product.title | escape }}</a>
      </h3>
      <span class="swipe-card__price" data-quick-buy-price>{{ current.price | money }}</span>
    </div>
    {%- if subtitle != blank -%}
      <p class="swipe-card__subtitle">{{ subtitle }}</p>
    {%- endif -%}

    {%- form 'product', product, class: 'swipe-card__form', data-product-form: '' -%}
      <input type="hidden" name="id" value="{{ current.id }}" data-quick-buy-id>

      {%- if show_picker -%}
        <fieldset class="swipe-card__picker">
          <legend class="swipe-card__picker-legend">
            {{ first_option.name }}: <span data-quick-buy-value>{{ current.option1 }}</span>
          </legend>
          <div class="swipe-card__options">
            {%- for value in first_option.values -%}
              {%- assign value_variant = value.variant -%}
              {%- if value_variant -%}
                <button
                  type="button"
                  class="swipe-card__option{% if value.swatch %} swipe-card__option--swatch{% endif %}"
                  aria-pressed="{{ value.selected }}"
                  aria-label="{{ value.name | escape }}"
                  title="{{ value.name | escape }}"
                  data-variant-id="{{ value_variant.id }}"
                  data-variant-price="{{ value_variant.price | money | escape }}"
                  data-variant-available="{{ value_variant.available }}"
                  data-variant-value="{{ value.name | escape }}"
                  {% if value.swatch.image %}
                    style="--swatch: url({{ value.swatch.image | image_url: width: 80 }})"
                  {% elsif value.swatch.color %}
                    style="--swatch: {{ value.swatch.color }}"
                  {% endif %}
                >
                  {%- unless value.swatch -%}
                    {{ value.name }}
                  {%- endunless -%}
                </button>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </fieldset>
      {%- endif -%}

      {%- if product.options.size > 1 -%}
        <a href="{{ product.url }}" class="button button--full swipe-card__buy">
          {{ 'products.choose_options' | t }}
        </a>
      {%- else -%}
        <button
          type="submit"
          name="add"
          class="button button--full swipe-card__buy"
          data-quick-buy-button
          data-label="{{ 'products.buy_title' | t: title: product.title | escape }}"
          {% unless current.available %}
            disabled
          {% endunless %}
        >
          {%- if current.available -%}
            <span data-quick-buy-label>{{ 'products.buy_title' | t: title: product.title }}</span>
            <span aria-hidden="true">&nbsp;&ndash;&nbsp;</span>
            <span data-quick-buy-price>{{ current.price | money }}</span>
          {%- else -%}
            {{ 'products.sold_out' | t }}
          {%- endif -%}
        </button>
      {%- endif -%}
    {%- endform -%}
  </div>
</article>

{% stylesheet %}
  .swipe-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    gap: 0.9rem;
  }

  .swipe-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 1.5rem;
  }

  .swipe-card__label {
    font-size: 0.8125rem;
    color: var(--color-heading);
  }

  .swipe-card__media {
    display: block;
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--color-surface);
  }

  .swipe-card__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }

  @media (hover: hover) {
    .swipe-card__media:hover .swipe-card__image {
      transform: scale(1.03);
    }
  }

  .swipe-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1;
  }

  .swipe-card__heading {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  .swipe-card__title {
    font-family: var(--font-body--family);
    font-size: 1.125rem;
    font-weight: 500;
    letter-spacing: 0;
  }

  .swipe-card__title a {
    text-decoration: none;
  }

  .swipe-card__price {
    color: var(--color-heading);
    white-space: nowrap;
  }

  .swipe-card__subtitle {
    font-size: 0.8125rem;
  }

  .swipe-card__form {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    margin-top: auto;
  }

  .swipe-card__picker {
    border: 0;
    padding: 0;
    margin: 0;
  }

  .swipe-card__picker-legend {
    padding: 0;
    margin-bottom: 0.5rem;
    font-size: 0.75rem;
  }

  .swipe-card__options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .swipe-card__option {
    min-width: 2rem;
    height: 2rem;
    padding: 0 0.75rem;
    border: 1px solid var(--color-border);
    background: var(--color-background);
    color: var(--color-heading);
    font-size: 0.75rem;
    cursor: pointer;
    border-radius: var(--style-border-radius-buttons);
  }

  .swipe-card__option--swatch {
    width: 1.75rem;
    min-width: 0;
    height: 1.75rem;
    padding: 0;
    border-radius: 50%;
    background: var(--swatch) center / cover;
    box-shadow: inset 0 0 0 2px var(--color-background);
  }

  .swipe-card__option[aria-pressed='true'] {
    border-color: var(--color-heading);
  }

  .swipe-card__option:not(.swipe-card__option--swatch)[aria-pressed='true'] {
    background: var(--color-primary);
    color: var(--color-primary-contrast);
  }

  .swipe-card__option[data-variant-available='false'] {
    opacity: 0.4;
  }

  .swipe-card__buy {
    min-height: 3.25rem;
  }
{% endstylesheet %}
