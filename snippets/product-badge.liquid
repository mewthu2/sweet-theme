{% doc %}
  Renders a product badge. Uses the `custom.badge_image` metafield (award seal),
  then `custom.badge`, then a tag prefixed with `badge:` (e.g. `badge:novo`), then a sale label.

  @param {product} product - The product
  @param {string} [class] - Optional class

  @example
  {% render 'product-badge', product: product %}
{% enddoc %}

{%- liquid
  assign badge_image = product.metafields.custom.badge_image.value
  assign label = product.metafields.custom.badge.value
  if label == blank
    for tag in product.tags
      assign prefix = tag | slice: 0, 6 | downcase
      if prefix == 'badge:'
        assign label = tag | remove_first: 'badge:' | remove_first: 'Badge:' | strip
        break
      endif
    endfor
  endif
  if label == blank and product.compare_at_price > product.price
    assign label = 'products.on_sale' | t
  endif
  if label == blank and product.available == false
    assign label = 'products.sold_out' | t
  endif
-%}

{%- if badge_image -%}
  <span class="badge-seal {{ class }}">
    {{ badge_image | image_url: width: 120 | image_tag: width: 48, height: 48, loading: 'lazy', alt: label }}
  </span>
{%- elsif label != blank -%}
  <span class="pill {{ class }}">{{ label }}</span>
{%- endif -%}

{% stylesheet %}
  .badge-seal img {
    width: 3rem;
    height: 3rem;
    object-fit: contain;
  }
{% endstylesheet %}
