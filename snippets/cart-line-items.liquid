{% doc %}
  Renders the list of cart line items with quantity controls.
  Quantity links work without JavaScript; with `ajax` they are handled by theme.js.

  @param {boolean} [ajax] - Adds data attributes so theme.js updates the cart drawer in place

  @example
  {% render 'cart-line-items', ajax: true %}
{% enddoc %}

<ul class="cart-items" role="list">
  {%- for item in cart.items -%}
    {%- liquid
      assign line = forloop.index
      assign qty_minus = item.quantity | minus: 1
      assign qty_plus = item.quantity | plus: 1
    -%}
    <li class="cart-item" data-cart-item>
      <a href="{{ item.url }}" class="cart-item__media" tabindex="-1" aria-hidden="true">
        {%- if item.image -%}
          {{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', class: 'cart-item__image', alt: '' }}
        {%- endif -%}
      </a>
      <div class="cart-item__details">
        <div class="cart-item__row">
          <a href="{{ item.url }}" class="cart-item__title product-title-case">{{ item.product.title | escape }}</a>
          <span class="cart-item__price">
            {%- if item.original_line_price > item.final_line_price -%}
              <s>{{ item.original_line_price | money }}</s>
            {%- endif -%}
            {{ item.final_line_price | money }}
          </span>
        </div>
        {%- unless item.product.has_only_default_variant -%}
          <p class="cart-item__variant">{{ item.variant.title }}</p>
        {%- endunless -%}
        {%- for property in item.properties -%}
          {%- assign first_char = property.first | slice: 0 -%}
          {%- if property.last != blank and first_char != '_' -%}
            <p class="cart-item__variant">{{ property.first }}: {{ property.last }}</p>
          {%- endif -%}
        {%- endfor -%}
        {%- for discount in item.line_level_discount_allocations -%}
          <p class="cart-item__discount">{{ discount.discount_application.title }} (-{{ discount.amount | money }})</p>
        {%- endfor -%}
        <div class="cart-item__row cart-item__row--controls">
          <div class="cart-item__quantity">
            <a
              href="{{ routes.cart_change_url }}?line={{ line }}&quantity={{ qty_minus }}"
              class="cart-item__qty-button"
              {% if ajax %}
                data-cart-quantity="{{ qty_minus }}" data-line="{{ line }}"
              {% endif %}
            >
              {% render 'icon', name: 'minus' %}
              <span class="visually-hidden">{{ 'products.decrease_quantity' | t }}</span>
            </a>
            <span class="cart-item__qty" aria-label="{{ 'products.quantity' | t }}">{{ item.quantity }}</span>
            <a
              href="{{ routes.cart_change_url }}?line={{ line }}&quantity={{ qty_plus }}"
              class="cart-item__qty-button"
              {% if ajax %}
                data-cart-quantity="{{ qty_plus }}" data-line="{{ line }}"
              {% endif %}
            >
              {% render 'icon', name: 'plus' %}
              <span class="visually-hidden">{{ 'products.increase_quantity' | t }}</span>
            </a>
          </div>
          <a
            href="{{ item.url_to_remove }}"
            class="cart-item__remove"
            {% if ajax %}
              data-cart-quantity="0" data-line="{{ line }}"
            {% endif %}
          >
            {{- 'cart.remove' | t -}}
          </a>
        </div>
      </div>
    </li>
  {%- endfor -%}
</ul>

{% stylesheet %}
  .cart-items {
    display: grid;
    gap: 1.25rem;
    padding: 0;
    list-style: none;
  }

  .cart-item {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 1rem;
    transition: opacity 0.2s var(--ease);
  }

  .cart-item[aria-busy='true'] {
    opacity: 0.5;
    pointer-events: none;
  }

  .cart-item__media {
    display: block;
    aspect-ratio: 4 / 5;
    background: var(--color-surface);
    overflow: hidden;
  }

  .cart-item__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cart-item__details {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.8125rem;
  }

  .cart-item__row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .cart-item__row--controls {
    align-items: center;
    margin-top: auto;
  }

  .cart-item__title {
    color: var(--color-heading);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
  }

  .cart-item__price {
    color: var(--color-heading);
    white-space: nowrap;
    text-align: right;
  }

  .cart-item__price s {
    display: block;
    color: var(--color-foreground);
    font-size: 0.75rem;
  }

  .cart-item__discount {
    color: var(--color-sale);
  }

  .cart-item__quantity {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--color-border);
    border-radius: var(--style-border-radius-buttons);
  }

  .cart-item__qty-button {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    color: var(--color-heading);
  }

  .cart-item__qty {
    min-width: 1.5rem;
    text-align: center;
    color: var(--color-heading);
  }

  .cart-item__remove {
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
{% endstylesheet %}
