{% doc %}
  Renders an inline SVG icon.

  @param {string} name - Icon name: phone, whatsapp, pin, close, menu, search, account, bag, plus, minus, chevron-down, arrow-left, arrow-right, instagram, tiktok, youtube, pinterest
  @param {string} [class] - Optional class for the svg element

  @example
  {% render 'icon', name: 'close' %}
{% enddoc %}

{%- case name -%}
  {%- when 'phone' -%}
    <svg class="icon {{ class }}" aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M5.5 2.5h-2a1 1 0 00-1 1.1C3.1 11 9 16.9 16.4 17.5a1 1 0 001.1-1v-2a1 1 0 00-.8-1l-2.9-.7a1 1 0 00-1 .3l-1.2 1.3a11.5 11.5 0 01-5-5l1.3-1.2a1 1 0 00.3-1L7.5 3.3a1 1 0 00-1-.8z"/></svg>
  {%- when 'whatsapp' -%}
    <svg class="icon {{ class }}" aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M3.2 16.8l1-3.4a7.5 7.5 0 112.9 2.7z"/><path d="M7.6 6.6c.3-.4.8-.4 1 0l.6 1.2c.1.3 0 .6-.2.8l-.4.4c.4.9 1.2 1.7 2.1 2.1l.4-.4c.2-.2.5-.3.8-.2l1.2.6c.4.2.4.7 0 1-.7.7-1.6.9-2.5.5a6.6 6.6 0 01-3.5-3.5c-.4-.9-.2-1.8.5-2.5z" fill="currentColor" stroke="none"/></svg>
  {%- when 'pin' -%}
    <svg class="icon {{ class }}" aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M10 18s-5.5-5.2-5.5-9.5a5.5 5.5 0 0111 0C15.5 12.8 10 18 10 18z"/><circle cx="10" cy="8.5" r="2"/></svg>
  {%- when 'close' -%}
    <svg class="icon {{ class }}" aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M4 4l12 12M16 4L4 16"/></svg>
  {%- when 'menu' -%}
    <svg class="icon {{ class }}" aria-hidden="true" focusable="false" width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M2 6h18M2 11h18M2 16h18"/></svg>
  {%- when 'search' -%}
    <svg class="icon {{ class }}" aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.3"><circle cx="8.5" cy="8.5" r="6"/><path d="M13 13l5 5"/></svg>
  {%- when 'account' -%}
    <svg class="icon {{ class }}" aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.3"><circle cx="10" cy="6.5" r="3.5"/><path d="M3 18c.8-3.6 3.6-5.5 7-5.5s6.2 1.9 7 5.5"/></svg>
  {%- when 'bag' -%}
    <svg class="icon {{ class }}" aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M3.5 6.5h13l-1 11h-11z"/><path d="M7 8V5a3 3 0 016 0v3"/></svg>
  {%- when 'plus' -%}
    <svg class="icon {{ class }}" aria-hidden="true" focusable="false" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M7 1v12M1 7h12"/></svg>
  {%- when 'minus' -%}
    <svg class="icon {{ class }}" aria-hidden="true" focusable="false" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M1 7h12"/></svg>
  {%- when 'chevron-down' -%}
    <svg class="icon {{ class }}" aria-hidden="true" focusable="false" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M2 4l4 4 4-4"/></svg>
  {%- when 'arrow-left' -%}
    <svg class="icon {{ class }}" aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M17 10H3M8 5l-5 5 5 5"/></svg>
  {%- when 'arrow-right' -%}
    <svg class="icon {{ class }}" aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M3 10h14M12 5l5 5-5 5"/></svg>
  {%- when 'instagram' -%}
    <svg class="icon {{ class }}" aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.3"><rect x="2.5" y="2.5" width="15" height="15" rx="4"/><circle cx="10" cy="10" r="3.5"/><circle cx="14.6" cy="5.4" r=".6" fill="currentColor"/></svg>
  {%- when 'tiktok' -%}
    <svg class="icon {{ class }}" aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M11.5 2.5v10.2a3 3 0 11-3-3M11.5 2.5c.3 2.3 1.9 3.9 4.5 4.1"/></svg>
  {%- when 'youtube' -%}
    <svg class="icon {{ class }}" aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.3"><rect x="1.5" y="4" width="17" height="12" rx="3"/><path d="M8.5 7.5v5l4-2.5z" fill="currentColor"/></svg>
  {%- when 'pinterest' -%}
    <svg class="icon {{ class }}" aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.3"><circle cx="10" cy="10" r="7.5"/><path d="M9 8.5c0-1.4 1-2.3 2.3-2.3s2.2 1 2.2 2.2c0 1.8-1 3.1-2.3 3.1-.7 0-1.2-.4-1.2-1M9.3 9.5L7.6 17"/></svg>
{%- endcase -%}
