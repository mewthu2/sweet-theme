[
  {
    "name": "theme_info",
    "theme_name": "Sweet",
    "theme_version": "2.0.0",
    "theme_author": "Sweet Sixteen",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://www.sweetsixteen.com.br/"
  },
  {
    "name": "Cores",
    "settings": [
      {
        "type": "header",
        "content": "Paleta Sweet Sixteen"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Fundo da página",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Texto, títulos e ícones",
        "default": "#244930"
      },
      {
        "type": "color",
        "id": "color_muted",
        "label": "Texto secundário",
        "info": "Abas inativas, estrelas, observações.",
        "default": "#747C6C"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Fundo dos cards (seções)",
        "default": "#F3F2E7"
      },
      {
        "type": "color",
        "id": "color_card",
        "label": "Fundo dos cards de produto",
        "default": "#F6F6F1"
      },
      {
        "type": "color",
        "id": "color_primary",
        "label": "Botão principal",
        "default": "#244930"
      },
      {
        "type": "color",
        "id": "color_primary_contrast",
        "label": "Texto do botão principal",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Destaque (creme)",
        "default": "#EEEDBC"
      },
      {
        "type": "color",
        "id": "color_sale",
        "label": "Preço promocional",
        "default": "#CC4845"
      }
    ]
  },
  {
    "name": "Tipografia",
    "settings": [
      {
        "type": "select",
        "id": "body_font_source",
        "label": "Fonte principal",
        "options": [
          { "value": "system", "label": "Helvetica do sistema (igual à Rhode)" },
          { "value": "picker", "label": "Escolher da biblioteca Shopify" }
        ],
        "default": "system",
        "info": "Helvetica Neue no Mac/iPhone, Arial no Windows."
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Fonte da biblioteca",
        "default": "archivo_n4"
      },
      {
        "type": "font_picker",
        "id": "type_display_font",
        "label": "Fonte de destaque",
        "info": "Usada nas palavras grandes dos cards de produto e no nome do produto.",
        "default": "archivo_black_n4"
      },
      {
        "type": "range",
        "id": "body_font_size",
        "min": 14,
        "max": 18,
        "step": 1,
        "unit": "px",
        "label": "Tamanho base do texto",
        "default": 16
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_margin",
        "min": 8,
        "max": 48,
        "step": 2,
        "unit": "px",
        "label": "Margem ao redor dos cards (desktop)",
        "default": 32
      },
      {
        "type": "range",
        "id": "section_gap",
        "min": 8,
        "max": 64,
        "step": 2,
        "unit": "px",
        "label": "Espaço entre seções",
        "default": 32
      },
      {
        "type": "range",
        "id": "card_radius",
        "min": 0,
        "max": 32,
        "step": 1,
        "unit": "px",
        "label": "Arredondamento dos cards",
        "default": 12
      },
      {
        "type": "range",
        "id": "button_radius",
        "min": 0,
        "max": 40,
        "step": 1,
        "unit": "px",
        "label": "Arredondamento dos botões",
        "info": "40 = formato pílula.",
        "default": 40
      }
    ]
  },
  {
    "name": "Carrinho",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Ao adicionar ao carrinho",
        "options": [
          { "value": "drawer", "label": "Abrir gaveta lateral" },
          { "value": "page", "label": "Ir para a página do carrinho" }
        ],
        "default": "drawer"
      },
      {
        "type": "text",
        "id": "free_shipping_threshold",
        "label": "Frete grátis a partir de (R$)",
        "info": "Deixe vazio para ocultar a barra de progresso. Ex.: 299",
        "default": "299"
      }
    ]
  },
  {
    "name": "Redes sociais",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram",
        "default": "https://www.instagram.com/"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "TikTok"
      },
      {
        "type": "text",
        "id": "social_youtube",
        "label": "YouTube"
      },
      {
        "type": "text",
        "id": "social_pinterest",
        "label": "Pinterest"
      }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      }
    ]
  }
]
