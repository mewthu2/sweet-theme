<dialog class="cart-drawer" data-cart-drawer aria-labelledby="CartDrawerTitle" scroll-lock>
  <div class="cart-drawer__inner" data-cart-drawer-inner>
    <div class="cart-drawer__header">
      <h2 id="CartDrawerTitle" class="cart-drawer__title">
        {{- 'cart.title' | t }} ({{ cart.item_count -}})
      </h2>
      <button type="button" class="cart-drawer__close" data-cart-close>
        {% render 'icon', name: 'close' %}
        <span class="visually-hidden">{{ 'general.close' | t }}</span>
      </button>
    </div>

    {%- if cart.item_count > 0 -%}
      <div class="cart-drawer__shipping">
        {% render 'free-shipping-bar' %}
      </div>
      <div class="cart-drawer__body">
        {% render 'cart-line-items', ajax: true %}
      </div>
      <div class="cart-drawer__footer">
        {%- for discount in cart.cart_level_discount_applications -%}
          <div class="cart-drawer__line">
            <span>{{ discount.title }}</span>
            <span>-{{ discount.total_allocated_amount | money }}</span>
          </div>
        {%- endfor -%}
        <div class="cart-drawer__line cart-drawer__line--total">
          <span>{{ 'cart.subtotal' | t }}</span>
          <span>{{ cart.total_price | money }}</span>
        </div>
        <p class="cart-drawer__note">{{ 'cart.taxes_and_shipping' | t }}</p>
        <form action="{{ routes.cart_url }}" method="post">
          <button type="submit" name="checkout" class="button button--solid button--full cart-drawer__checkout">
            {{- 'cart.checkout' | t }} &ndash; {{ cart.total_price | money -}}
          </button>
        </form>
        <a href="{{ routes.cart_url }}" class="cart-drawer__view">{{ 'cart.view_cart' | t }}</a>
      </div>
    {%- else -%}
      <div class="cart-drawer__empty">
        <p>{{ 'cart.empty' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="button button--solid">{{ 'cart.continue_shopping' | t }}</a>
      </div>
    {%- endif -%}
  </div>
</dialog>

{% stylesheet %}
  .cart-drawer {
    width: min(30rem, calc(100vw - 1rem));
    max-width: none;
    height: calc(100% - 1rem);
    max-height: none;
    margin: 0.5rem 0.5rem 0.5rem auto;
    padding: 0;
    border: 0;
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-heading);
    transform: translateX(calc(100% + 1rem));
    transition: transform 0.35s var(--ease);
  }

  .cart-drawer.is-open {
    transform: none;
  }

  .cart-drawer::backdrop {
    background: var(--color-overlay);
  }

  .cart-drawer__inner {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .cart-drawer__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 1.5rem;
  }

  .cart-drawer__title {
    font-size: 1rem;
    text-transform: uppercase;
  }

  .cart-drawer__close {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    margin-right: -0.5rem;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  .cart-drawer__shipping {
    margin: 0 1.5rem;
    padding: 1rem 1.25rem;
    border-radius: var(--radius-small);
    background: var(--color-background);
  }

  .cart-drawer__body {
    flex: 1;
    overflow-y: auto;
    padding: 1.5rem;
  }

  .cart-drawer__footer {
    display: grid;
    gap: 0.75rem;
    padding: 1.25rem 1.5rem 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .cart-drawer__line {
    display: flex;
    justify-content: space-between;
  }

  .cart-drawer__line--total {
    font-size: 1.125rem;
    font-weight: var(--font-bold--weight);
  }

  .cart-drawer__note {
    font-size: 0.875rem;
    color: var(--color-muted);
  }

  .cart-drawer__view {
    justify-self: center;
    text-transform: uppercase;
  }

  .cart-drawer__empty {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    padding: 2rem;
    text-align: center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Gaveta do carrinho",
  "settings": []
}
{% endschema %}
