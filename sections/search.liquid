<div class="search-page" style="--columns: 4;">
  <h1 class="search-page__title">{{ 'search.title' | t }}</h1>

  <form action="{{ routes.search_url }}" method="get" role="search" class="search-page__form">
    <label for="SearchPageInput" class="visually-hidden">{{ 'search.placeholder' | t }}</label>
    <input
      id="SearchPageInput"
      type="search"
      name="q"
      class="field"
      value="{{ search.terms | escape }}"
      placeholder="{{ 'search.placeholder' | t }}"
    >
    <button type="submit" class="button">{{ 'search.submit' | t }}</button>
  </form>

  {%- if search.performed -%}
    {%- if search.results_count == 0 -%}
      <p class="search-page__status">{{ 'search.no_results_html' | t: terms: search.terms }}</p>
    {%- else -%}
      <p class="search-page__status">{{ 'search.results_for_html' | t: terms: search.terms, count: search.results_count }}</p>

      {%- paginate search.results by 24 -%}
        <ul class="product-grid" role="list">
          {%- for result in search.results -%}
            <li>
              {%- if result.object_type == 'product' -%}
                {% render 'product-card', product: result, show_quick_add: true %}
              {%- else -%}
                <article class="search-result">
                  <p class="eyebrow">{{ result.object_type }}</p>
                  <h3 class="search-result__title"><a href="{{ result.url }}">{{ result.title }}</a></h3>
                  <p>{{ result.content | strip_html | truncatewords: 20 }}</p>
                </article>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>

        {%- if paginate.pages > 1 -%}
          <nav class="pagination" aria-label="{{ 'general.pagination' | t }}">
            {{ paginate | default_pagination: next: '→', previous: '←' }}
          </nav>
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  {%- endif -%}
</div>

{% stylesheet %}
  .search-page__title {
    margin-bottom: 1.5rem;
  }

  .search-page__form {
    display: flex;
    gap: 0.5rem;
    max-width: 40rem;
    margin-bottom: 1.5rem;
  }

  .search-page__status {
    margin-bottom: 2rem;
  }

  .search-result {
    display: grid;
    gap: 0.5rem;
    padding: 1.5rem;
    height: 100%;
    background: var(--color-surface);
  }

  .search-result__title a {
    text-decoration: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.search",
  "settings": []
}
{% endschema %}
