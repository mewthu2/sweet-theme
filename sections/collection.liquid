{%- liquid
  assign banner_image = collection.image | default: section.settings.fallback_image
  assign chips_menu = section.settings.chips_menu
-%}

<div class="collection-page">
  {%- if section.settings.show_banner -%}
    <div class="collection-banner card{% if banner_image == blank %} collection-banner--plain{% endif %}">
      {%- if banner_image -%}
        {{
          banner_image
          | image_url: width: 2800
          | image_tag: class: 'collection-banner__image', sizes: '100vw', widths: '750, 1100, 1500, 2000, 2800', loading: 'eager', fetchpriority: 'high'
        }}
      {%- endif -%}
      <div class="collection-banner__content">
        <h1 class="collection-banner__title">{{ collection.title }}</h1>
        {%- if collection.description != blank and section.settings.show_description -%}
          <div class="collection-banner__description">{{ collection.description | strip_html | truncatewords: 30 }}</div>
        {%- endif -%}
      </div>
    </div>
  {%- else -%}
    <h1 class="visually-hidden">{{ collection.title }}</h1>
  {%- endif -%}

  {%- if chips_menu.links.size > 0 -%}
    <nav class="collection-chips" aria-label="{{ 'collections.title' | t }}">
      <ul role="list">
        {%- for link in chips_menu.links -%}
          <li>
            <a
              href="{{ link.url }}"
              class="button collection-chips__chip{% if link.active %} is-active{% endif %}"
              {% if link.active %}
                aria-current="page"
              {% endif %}
            >
              {{- link.title -}}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </nav>
  {%- endif -%}

  {%- paginate collection.products by section.settings.products_per_page -%}
    <form class="collection-toolbar" id="CollectionFilters" data-auto-submit>
      <div class="collection-toolbar__left">
        {%- if section.settings.enable_sorting -%}
          {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
          <label class="collection-toolbar__sort">
            <span>{{ 'collections.sort_by' | t }}:</span>
            <select name="sort_by">
              {%- for option in collection.sort_options -%}
                <option
                  value="{{ option.value }}"
                  {% if option.value == sort_by %}
                    selected
                  {% endif %}
                >
                  {{ option.name | downcase }}
                </option>
              {%- endfor -%}
            </select>
            {% render 'icon', name: 'chevron-down' %}
          </label>
        {%- endif -%}

        {%- if section.settings.enable_filtering -%}
          {%- for filter in collection.filters -%}
            <details class="filter">
              <summary class="filter__summary">
                {{ filter.label }}
                {%- if filter.active_values.size > 0 %} ({{ filter.active_values.size }}){% endif %}
                {% render 'icon', name: 'chevron-down' %}
              </summary>
              <div class="filter__panel">
                {%- case filter.type -%}
                  {%- when 'list', 'boolean' -%}
                    {%- for value in filter.values -%}
                      <label class="filter__option{% if value.count == 0 and value.active == false %} is-disabled{% endif %}">
                        <input
                          type="checkbox"
                          name="{{ value.param_name }}"
                          value="{{ value.value }}"
                          {% if value.active %}
                            checked
                          {% endif %}
                          {% if value.count == 0 and value.active == false %}
                            disabled
                          {% endif %}
                        >
                        <span>{{ value.label }} ({{ value.count }})</span>
                      </label>
                    {%- endfor -%}
                  {%- when 'price_range' -%}
                    <div class="filter__price">
                      <label>
                        <span class="visually-hidden">{{ 'collections.from' | t }}</span>
                        <input
                          class="field"
                          type="number"
                          name="{{ filter.min_value.param_name }}"
                          min="0"
                          max="{{ filter.range_max | divided_by: 100 }}"
                          placeholder="{{ 'collections.from' | t }} {{ cart.currency.symbol }}0"
                          {% if filter.min_value.value %}
                            value="{{ filter.min_value.value | divided_by: 100 }}"
                          {% endif %}
                        >
                      </label>
                      <label>
                        <span class="visually-hidden">{{ 'collections.to' | t }}</span>
                        <input
                          class="field"
                          type="number"
                          name="{{ filter.max_value.param_name }}"
                          min="0"
                          max="{{ filter.range_max | divided_by: 100 }}"
                          placeholder="{{ 'collections.to' | t }} {{ cart.currency.symbol }}{{ filter.range_max | divided_by: 100 }}"
                          {% if filter.max_value.value %}
                            value="{{ filter.max_value.value | divided_by: 100 }}"
                          {% endif %}
                        >
                      </label>
                    </div>
                {%- endcase -%}
                <button type="submit" class="link-button filter__apply">{{ 'collections.apply' | t }}</button>
              </div>
            </details>
          {%- endfor -%}
        {%- endif -%}
      </div>

      <div class="collection-toolbar__right">
        <span>{{ 'collections.product_count' | t: count: collection.products_count }}</span>
        <div class="grid-toggle" role="group" aria-label="{{ 'collections.view_grid' | t }}">
          <button type="button" class="grid-toggle__button" data-grid-columns="2" aria-pressed="false">
            <svg class="grid-toggle__icon" aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><rect x="0" y="0" width="11" height="11" rx="1.5"/><rect x="13" y="0" width="11" height="11" rx="1.5"/><rect x="0" y="13" width="11" height="11" rx="1.5"/><rect x="13" y="13" width="11" height="11" rx="1.5"/></svg>
            <span class="visually-hidden">2</span>
          </button>
          <button type="button" class="grid-toggle__button" data-grid-columns="3" aria-pressed="true">
            <svg class="grid-toggle__icon" aria-hidden="true" width="36" height="24" viewBox="0 0 36 24" fill="currentColor"><rect x="0" y="0" width="10.5" height="11" rx="1.5"/><rect x="12.75" y="0" width="10.5" height="11" rx="1.5"/><rect x="25.5" y="0" width="10.5" height="11" rx="1.5"/><rect x="0" y="13" width="10.5" height="11" rx="1.5"/><rect x="12.75" y="13" width="10.5" height="11" rx="1.5"/><rect x="25.5" y="13" width="10.5" height="11" rx="1.5"/></svg>
            <span class="visually-hidden">3</span>
          </button>
        </div>
      </div>
    </form>

    {%- liquid
      assign active_filters = 0
      for filter in collection.filters
        assign active_filters = active_filters | plus: filter.active_values.size
        if filter.type == 'price_range'
          if filter.min_value.value or filter.max_value.value
            assign active_filters = active_filters | plus: 1
          endif
        endif
      endfor
    -%}
    {%- if active_filters > 0 -%}
      <div class="active-filters">
        {%- for filter in collection.filters -%}
          {%- for value in filter.active_values -%}
            <a href="{{ value.url_to_remove }}" class="button active-filters__pill">
              {{ value.label }}
              {% render 'icon', name: 'close' %}
            </a>
          {%- endfor -%}
          {%- if filter.type == 'price_range' -%}
            {%- if filter.min_value.value or filter.max_value.value -%}
              <a href="{{ filter.url_to_remove }}" class="button active-filters__pill">
                {{ filter.min_value.value | default: 0 | money_without_trailing_zeros }} – {{ filter.max_value.value | default: filter.range_max | money_without_trailing_zeros }}
                {% render 'icon', name: 'close' %}
              </a>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
        <a href="{{ collection.url }}?sort_by={{ collection.sort_by }}" class="active-filters__clear">{{ 'collections.clear_all' | t }}</a>
      </div>
    {%- endif -%}

    {%- if collection.products.size > 0 -%}
      <ul class="product-grid collection-grid" role="list" style="--columns: 3;" data-collection-grid>
        {%- for product in collection.products -%}
          {%- liquid
            assign lazy = true
            if forloop.index <= 3
              assign lazy = false
            endif
          -%}
          {%- if paginate.current_page == 1 -%}
            {%- for block in section.blocks -%}
              {%- if block.settings.position == forloop.parentloop.index -%}
                <li class="collection-promo-slot" {{ block.shopify_attributes }}>
                  <a href="{{ block.settings.link | default: collection.url }}" class="collection-promo card" style="--promo-fg: {{ block.settings.text_color }};">
                    {%- if block.settings.image -%}
                      {{ block.settings.image | image_url: width: 1000 | image_tag: class: 'collection-promo__image', sizes: '(min-width: 750px) 33vw, 50vw', widths: '400, 700, 1000', loading: 'lazy' }}
                    {%- endif -%}
                    <span class="collection-promo__text">
                      {%- if block.settings.heading != blank -%}
                        <span class="collection-promo__heading">{{ block.settings.heading }}</span>
                      {%- endif -%}
                      {%- if block.settings.button_label != blank -%}
                        <span class="button button--light">{{ block.settings.button_label }}</span>
                      {%- endif -%}
                    </span>
                  </a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
          <li>{% render 'product-card', product: product, show_quick_add: section.settings.show_quick_add, lazy: lazy %}</li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p class="collection-page__empty">{{ 'collections.empty' | t }}</p>
    {%- endif -%}

    {%- if paginate.pages > 1 -%}
      <nav class="pagination" aria-label="{{ 'general.pagination' | t }}">
        {{ paginate | default_pagination: next: '→', previous: '←' }}
      </nav>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% javascript %}
  document.addEventListener('change', (event) => {
    const form = event.target.closest('form[data-auto-submit]');
    if (!form || event.target.type === 'number') return;
    form.requestSubmit();
  });

  document.addEventListener('click', (event) => {
    const button = event.target.closest('[data-grid-columns]');
    if (!button) return;
    const grid = document.querySelector('[data-collection-grid]');
    if (!grid) return;
    grid.style.setProperty('--columns', button.dataset.gridColumns);
    button.parentElement.querySelectorAll('[data-grid-columns]').forEach((el) => el.setAttribute('aria-pressed', String(el === button)));
    try {
      localStorage.setItem('sweet-grid-columns', button.dataset.gridColumns);
    } catch (error) {}
  });

  (() => {
    let saved;
    try {
      saved = localStorage.getItem('sweet-grid-columns');
    } catch (error) {}
    if (saved) document.querySelector(`[data-grid-columns="${saved}"]`)?.click();
  })();
{% endjavascript %}

{% stylesheet %}
  .collection-page {
    display: grid;
  }

  .collection-banner {
    position: relative;
    display: grid;
    place-items: center;
    min-height: clamp(16rem, 34vw, 27rem);
    color: #fff;
    text-align: center;
  }

  .collection-banner--plain {
    min-height: 12rem;
    color: var(--color-heading);
  }

  .collection-banner__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .collection-banner__content {
    position: relative;
    display: grid;
    gap: 0.75rem;
    max-width: 40rem;
    padding: 2rem;
  }

  .collection-banner__title {
    color: inherit;
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem);
    font-weight: 400;
  }

  .collection-banner__description {
    font-size: 1rem;
  }

  .collection-chips ul {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-top: 2rem;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
  }

  @media (max-width: 749px) {
    .collection-chips ul {
      justify-content: flex-start;
    }
  }

  .collection-chips__chip {
    min-height: 2.75rem;
    padding-inline: 1.25rem;
    font-size: 1.125rem;
  }

  .collection-chips__chip.is-active {
    background: var(--color-heading);
    color: var(--color-surface);
  }

  .collection-toolbar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin: 2rem 0 1.5rem;
  }

  .collection-toolbar__left {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 2rem;
  }

  .collection-toolbar__sort {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .collection-toolbar__sort select {
    appearance: none;
    padding: 0 1.25rem 0 0;
    border: 0;
    border-bottom: 1px solid currentcolor;
    border-radius: 0;
    font-weight: var(--font-bold--weight);
    cursor: pointer;
  }

  .collection-toolbar__sort .icon {
    position: absolute;
    right: 0;
    pointer-events: none;
  }

  .collection-toolbar__right {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .grid-toggle {
    display: flex;
    gap: 0.75rem;
  }

  @media (max-width: 749px) {
    .grid-toggle {
      display: none;
    }
  }

  .grid-toggle__button {
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    opacity: 0.4;
  }

  .grid-toggle__button[aria-pressed='true'] {
    opacity: 1;
  }

  .grid-toggle__icon {
    height: 1.4rem;
    width: auto;
    color: var(--color-heading);
  }

  .filter {
    position: relative;
  }

  .filter__summary {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    cursor: pointer;
    list-style: none;
  }

  .filter__summary::-webkit-details-marker {
    display: none;
  }

  .filter[open] .filter__summary .icon {
    transform: rotate(180deg);
  }

  .filter__panel {
    position: absolute;
    z-index: 5;
    top: calc(100% + 0.75rem);
    left: 0;
    display: grid;
    gap: 0.6rem;
    min-width: 15rem;
    max-height: 22rem;
    overflow-y: auto;
    padding: 1.25rem;
    border-radius: var(--radius);
    background: var(--color-surface);
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.06);
  }

  .filter__option {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    cursor: pointer;
  }

  .filter__option input {
    accent-color: var(--color-primary);
    width: 1rem;
    height: 1rem;
  }

  .filter__option.is-disabled {
    opacity: 0.4;
  }

  .filter__price {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
  }

  .filter__apply {
    justify-self: start;
  }

  .active-filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .active-filters__pill .icon {
    width: 0.75rem;
    height: 0.75rem;
  }

  .collection-promo {
    position: relative;
    display: flex;
    align-items: flex-start;
    height: 100%;
    min-height: 20rem;
    color: var(--promo-fg);
    text-decoration: none;
  }

  .collection-promo__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .collection-promo__text {
    position: relative;
    display: grid;
    justify-items: start;
    gap: 1rem;
    padding: clamp(1rem, 0.6rem + 1.2vw, 1.75rem);
  }

  .collection-promo__heading {
    font-size: clamp(1.5rem, 1.1rem + 1.2vw, 2.5rem);
    line-height: 1.12;
  }

  .collection-promo .button {
    --button-fg: var(--promo-fg);
  }

  .collection-page__empty {
    padding-block: 4rem;
    text-align: center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Coleção",
  "max_blocks": 4,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_banner",
      "label": "Mostrar banner",
      "default": true,
      "info": "Usa a imagem da coleção."
    },
    {
      "type": "image_picker",
      "id": "fallback_image",
      "label": "Imagem padrão do banner",
      "info": "Usada quando a coleção não tem imagem."
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Mostrar descrição no banner",
      "default": false
    },
    {
      "type": "link_list",
      "id": "chips_menu",
      "label": "Atalhos de coleções",
      "info": "Menu com as coleções mostradas como botões abaixo do banner (ex.: Destaques, Skincare, Kits, Ver tudo)."
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 6,
      "max": 48,
      "step": 3,
      "label": "Produtos por página",
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "Mostrar ordenação",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "Mostrar filtros",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "Mostrar compra rápida ao passar o mouse",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "promo",
      "name": "Card promocional",
      "settings": [
        {
          "type": "range",
          "id": "position",
          "min": 1,
          "max": 24,
          "step": 1,
          "label": "Posição na grade",
          "default": 6
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagem"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Título",
          "default": "O mais amado da Sweet."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Texto do botão",
          "default": "Comprar"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Cor do texto",
          "default": "#FFFFFF"
        }
      ]
    }
  ]
}
{% endschema %}
