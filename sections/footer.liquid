<footer
  class="site-footer full-width"
  style="--footer-bg: {{ section.settings.background }}; --footer-fg: {{ section.settings.foreground }};"
>
  <div class="site-footer__inner">
    <div class="site-footer__top">
      {%- if section.settings.show_newsletter -%}
        <div class="site-footer__newsletter">
          {%- if section.settings.newsletter_heading != blank -%}
            <h2 class="site-footer__heading">{{ section.settings.newsletter_heading }}</h2>
          {%- endif -%}
          {%- if section.settings.newsletter_text != blank -%}
            <div class="site-footer__text">{{ section.settings.newsletter_text }}</div>
          {%- endif -%}
          {%- form 'customer', id: 'FooterNewsletter', class: 'newsletter-form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            {%- if form.posted_successfully? -%}
              <p class="newsletter-form__message" role="status">{{ 'newsletter.success' | t }}</p>
            {%- else -%}
              <div class="newsletter-form__field">
                <label for="FooterNewsletterEmail" class="visually-hidden">{{ 'newsletter.email' | t }}</label>
                <input
                  id="FooterNewsletterEmail"
                  type="email"
                  name="contact[email]"
                  class="newsletter-form__input"
                  placeholder="{{ 'newsletter.email' | t }}"
                  autocomplete="email"
                  required
                  {% if form.errors %}
                    aria-invalid="true" aria-describedby="FooterNewsletterError"
                  {% endif %}
                >
                <button type="submit" class="newsletter-form__submit">
                  {{- 'newsletter.submit' | t -}}
                </button>
              </div>
              {%- if form.errors -%}
                <div id="FooterNewsletterError" class="newsletter-form__message">{{ form.errors | default_errors }}</div>
              {%- endif -%}
            {%- endif -%}
          {%- endform -%}
        </div>
      {%- endif -%}

      <div class="site-footer__menus">
        {%- for block in section.blocks -%}
          <div class="site-footer__menu" {{ block.shopify_attributes }}>
            {%- case block.type -%}
              {%- when 'menu' -%}
                {%- if block.settings.heading != blank -%}
                  <h3 class="site-footer__menu-heading">{{ block.settings.heading }}</h3>
                {%- endif -%}
                <ul role="list">
                  {%- for link in block.settings.menu.links -%}
                    <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- when 'text' -%}
                {%- if block.settings.heading != blank -%}
                  <h3 class="site-footer__menu-heading">{{ block.settings.heading }}</h3>
                {%- endif -%}
                <div class="site-footer__text">{{ block.settings.text }}</div>
            {%- endcase -%}
          </div>
        {%- endfor -%}
      </div>
    </div>

    <div class="site-footer__bottom">
      <div class="site-footer__social">
        {%- if settings.social_instagram != blank -%}
          <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener">
            {% render 'icon', name: 'instagram' %}<span class="visually-hidden">Instagram</span>
          </a>
        {%- endif -%}
        {%- if settings.social_tiktok != blank -%}
          <a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener">
            {% render 'icon', name: 'tiktok' %}<span class="visually-hidden">TikTok</span>
          </a>
        {%- endif -%}
        {%- if settings.social_youtube != blank -%}
          <a href="{{ settings.social_youtube }}" target="_blank" rel="noopener">
            {% render 'icon', name: 'youtube' %}<span class="visually-hidden">YouTube</span>
          </a>
        {%- endif -%}
      </div>

      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <ul class="site-footer__payments" role="list">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'site-footer__payment-icon' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <p class="site-footer__copyright">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url }}
        {%- if section.settings.legal_text != blank %} · {{ section.settings.legal_text }}{% endif %}
      </p>
    </div>

    {%- if section.settings.show_wordmark -%}
      <p class="site-footer__wordmark" aria-hidden="true">{{ section.settings.wordmark | default: shop.name }}</p>
    {%- endif -%}
  </div>
</footer>

{% stylesheet %}
  .site-footer {
    background: var(--footer-bg);
    color: var(--footer-fg);
    margin-top: auto;
    overflow: hidden;
  }

  .site-footer__inner {
    width: min(var(--page-width), 100%);
    margin-inline: auto;
    padding: clamp(3rem, 5vw, 4.5rem) var(--page-margin) 1.5rem;
  }

  .site-footer a {
    color: inherit;
    text-decoration: none;
  }

  .site-footer a:hover {
    text-decoration: underline;
  }

  .site-footer__top {
    display: grid;
    gap: 3rem;
  }

  @media (min-width: 990px) {
    .site-footer__top {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 4rem;
    }
  }

  .site-footer__heading {
    color: inherit;
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2rem);
    text-transform: lowercase;
    margin-bottom: 0.75rem;
  }

  .site-footer__text {
    font-size: 0.875rem;
    opacity: 0.85;
  }

  .newsletter-form {
    margin-top: 1.5rem;
  }

  .newsletter-form__field {
    display: flex;
    border-bottom: 1px solid currentcolor;
  }

  .newsletter-form__input {
    flex: 1;
    min-width: 0;
    min-height: 3rem;
    border: 0;
    background: none;
    color: inherit;
    outline: none;
  }

  .newsletter-form__input::placeholder {
    color: inherit;
    opacity: 0.6;
  }

  .newsletter-form__submit {
    border: 0;
    background: none;
    color: inherit;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .newsletter-form__message {
    margin-top: 0.75rem;
    font-size: 0.8125rem;
  }

  .site-footer__menus {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
  }

  @media (min-width: 750px) {
    .site-footer__menus {
      grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    }
  }

  .site-footer__menu-heading {
    color: inherit;
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .site-footer__menu ul {
    display: grid;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid currentcolor;
    border-color: color-mix(in srgb, currentcolor 20%, transparent);
    font-size: 0.75rem;
  }

  .site-footer__social {
    display: flex;
    gap: 1rem;
  }

  .site-footer__payments {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0;
    list-style: none;
  }

  .site-footer__payment-icon {
    width: 2.25rem;
    height: auto;
  }

  .site-footer__wordmark {
    margin: 2rem 0 -0.12em;
    font-family: var(--font-heading--family);
    font-size: clamp(4rem, 19vw, 18rem);
    line-height: 0.8;
    letter-spacing: -0.05em;
    text-transform: lowercase;
    text-align: center;
    white-space: nowrap;
    opacity: 0.95;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Rodapé",
  "class": "section-footer",
  "max_blocks": 5,
  "settings": [
    {
      "type": "color",
      "id": "background",
      "label": "Fundo",
      "default": "#E8E8EA"
    },
    {
      "type": "color",
      "id": "foreground",
      "label": "Texto",
      "default": "#2E543B"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Mostrar newsletter",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Título",
      "default": "entre para o clube sweet"
    },
    {
      "type": "richtext",
      "id": "newsletter_text",
      "label": "Texto",
      "default": "<p>Novidades, lançamentos e ofertas exclusivas no seu e-mail.</p>"
    },
    {
      "type": "header",
      "content": "Rodapé inferior"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Mostrar formas de pagamento",
      "default": true
    },
    {
      "type": "text",
      "id": "legal_text",
      "label": "Texto legal",
      "default": "SWEET COMERCIO LTDA"
    },
    {
      "type": "checkbox",
      "id": "show_wordmark",
      "label": "Mostrar marca grande no final",
      "default": true
    },
    {
      "type": "text",
      "id": "wordmark",
      "label": "Texto da marca",
      "default": "sweet sixteen"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Título",
          "default": "Loja"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "text",
      "name": "Texto",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Título",
          "default": "Atendimento"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Texto",
          "default": "<p>Seg. a sex., 9h às 18h</p>"
        }
      ]
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  }
}
{% endschema %}
