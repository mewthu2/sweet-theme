{%- liquid
  assign phone = section.settings.phone | strip
  assign phone_digits = phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')' | remove: '.' | remove: '+'
  assign whatsapp = section.settings.whatsapp | strip
  assign whatsapp_digits = whatsapp | remove: ' ' | remove: '-' | remove: '(' | remove: ')' | remove: '.' | remove: '+'
  if whatsapp_digits != blank and whatsapp_digits.size <= 11
    assign whatsapp_digits = '55' | append: whatsapp_digits
  endif
  assign whatsapp_url = 'https://wa.me/' | append: whatsapp_digits
  if section.settings.whatsapp_message != blank
    assign encoded_message = section.settings.whatsapp_message | url_encode
    assign whatsapp_url = 'https://wa.me/' | append: whatsapp_digits | append: '?text=' | append: encoded_message
  endif
-%}

<div
  class="announcement-bar"
  style="--announcement-bg: {{ section.settings.background }}; --announcement-fg: {{ section.settings.foreground }};"
>
  <div class="announcement-bar__inner">
    <div class="announcement-bar__side announcement-bar__side--left">
      {%- if phone != blank -%}
        <a href="tel:+{% if phone_digits.size <= 11 %}55{% endif %}{{ phone_digits }}" class="announcement-bar__contact">
          {% render 'icon', name: 'phone' %}
          <span class="announcement-bar__label">{{ phone }}</span>
          <span class="visually-hidden">{{ 'announcement.call' | t }}</span>
        </a>
      {%- endif -%}
      {%- if whatsapp_digits != blank -%}
        <a href="{{ whatsapp_url }}" class="announcement-bar__contact" target="_blank" rel="noopener">
          {% render 'icon', name: 'whatsapp' %}
          <span class="announcement-bar__label">{{ section.settings.whatsapp_label | default: whatsapp }}</span>
          <span class="visually-hidden">{{ 'announcement.whatsapp' | t }}</span>
        </a>
      {%- endif -%}
    </div>

    <announcement-bar class="announcement-bar__messages" data-speed="{{ section.settings.speed }}">
      {%- for block in section.blocks -%}
        <p class="announcement-bar__message" data-announcement {% unless forloop.first %}hidden{% endunless %} {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
          {%- else -%}
            {{ block.settings.text }}
          {%- endif -%}
        </p>
      {%- endfor -%}
    </announcement-bar>

    <div class="announcement-bar__side announcement-bar__side--right">
      {%- if section.settings.stores_label != blank -%}
        <a href="{{ section.settings.stores_link | default: routes.root_url }}" class="announcement-bar__contact">
          {% render 'icon', name: 'pin' %}
          <span class="announcement-bar__label">{{ section.settings.stores_label }}</span>
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .announcement-bar {
    border-radius: var(--radius);
    background: var(--announcement-bg);
    color: var(--announcement-fg);
    font-size: 0.75rem;
    font-weight: var(--font-bold--weight);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .announcement-bar__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    min-height: 2.5rem;
    padding: 0.35rem clamp(0.75rem, 0.5rem + 1.5vw, 2rem);
  }

  .announcement-bar__side {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .announcement-bar__side--right {
    justify-content: flex-end;
  }

  .announcement-bar__contact {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
  }

  .announcement-bar__contact .icon {
    width: 0.9rem;
    height: 0.9rem;
    flex: none;
  }

  .announcement-bar__contact:hover .announcement-bar__label {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  .announcement-bar__messages {
    display: grid;
    place-items: center;
    text-align: center;
  }

  .announcement-bar__message {
    grid-area: 1 / 1;
    animation: announcement-in 0.5s var(--ease);
  }

  .announcement-bar__message a {
    color: inherit;
    text-decoration: none;
  }

  @media (max-width: 749px) {
    .announcement-bar__inner {
      gap: 0.5rem;
    }

    .announcement-bar__side {
      gap: 0.25rem;
    }

    .announcement-bar__label {
      display: none;
    }

    .announcement-bar__contact {
      display: inline-grid;
      place-items: center;
      width: 1.75rem;
      height: 1.75rem;
    }

    .announcement-bar__messages {
      font-size: 0.625rem;
      letter-spacing: 0.06em;
    }
  }

  @keyframes announcement-in {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Barra de anúncios",
  "class": "section-announcement",
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "Contato (lado esquerdo)"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Telefone",
      "info": "Ex.: (11) 3000-0000"
    },
    {
      "type": "text",
      "id": "whatsapp",
      "label": "WhatsApp",
      "info": "Número com DDD. Ex.: (11) 99999-9999"
    },
    {
      "type": "text",
      "id": "whatsapp_label",
      "label": "Texto do WhatsApp",
      "info": "Opcional. Se vazio, mostra o número.",
      "default": "WhatsApp"
    },
    {
      "type": "text",
      "id": "whatsapp_message",
      "label": "Mensagem inicial do WhatsApp",
      "default": "Olá! Vim pelo site da Sweet Sixteen."
    },
    {
      "type": "header",
      "content": "Lojas (lado direito)"
    },
    {
      "type": "text",
      "id": "stores_label",
      "label": "Texto",
      "default": "Ver lojas"
    },
    {
      "type": "url",
      "id": "stores_link",
      "label": "Link",
      "info": "Página com os endereços das lojas."
    },
    {
      "type": "header",
      "content": "Aparência"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Fundo",
      "default": "#F3F2E7"
    },
    {
      "type": "color",
      "id": "foreground",
      "label": "Texto",
      "default": "#244930"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Troca de mensagem a cada",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Mensagem",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "Frete grátis para compras acima de R$ 299"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Barra de anúncios",
      "blocks": [{ "type": "message" }]
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
