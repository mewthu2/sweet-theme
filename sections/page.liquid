<article class="page-content section-spacing">
  <div class="page-width-narrow">
    <h1 class="page-content__title">{{ page.title }}</h1>
    <div class="rte">{{ page.content }}</div>
  </div>
</article>

{% stylesheet %}
  .page-content__title {
    margin-bottom: 2rem;
  }

  .page-content .rte {
    font-size: 1rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.page",
  "settings": []
}
{% endschema %}
