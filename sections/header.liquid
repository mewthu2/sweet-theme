{%- liquid
  assign menu = section.settings.menu
  assign logo = section.settings.logo
  assign logo_transparent = section.settings.logo_transparent
  assign logo_width = section.settings.logo_width
  assign logo_width_mobile = logo_width | times: 0.75 | round
  assign logo_sizes = '(min-width: 990px) ' | append: logo_width | append: 'px, ' | append: logo_width_mobile | append: 'px'

  assign transparent_enabled = false
  case section.settings.transparent_mode
    when 'home'
      if template.name == 'index'
        assign transparent_enabled = true
        assign transparent_scope = 'body'
      endif
    when 'auto'
      assign transparent_enabled = true
      assign transparent_scope = 'body:has(#MainContent > .section-hero:first-child)'
  endcase
-%}

{%- if transparent_enabled -%}
  {%- capture transparent_state -%}
    {{ transparent_scope }} .site-header--transparent:not(.is-solid, :hover, :focus-within, :has(.is-open, .header-search[open]))
  {%- endcapture -%}
  {% style %}
    {{ transparent_scope }} #MainContent {
      margin-top: calc(var(--header-height) * -1);
      padding-top: 0;
    }

    {{ transparent_scope }} .hero__content {
      padding-top: calc(var(--header-height) + 1.5rem);
    }

    {{ transparent_state }} {
      background: transparent;
      color: var(--header-fg-transparent);
    }

    {%- if logo_transparent -%}
      {{ transparent_state }} .site-header__logo-default {
        display: none;
      }

      {{ transparent_state }} .site-header__logo-transparent {
        display: block;
      }
    {%- endif -%}
  {% endstyle %}
{%- endif -%}

<header
  class="site-header{% if section.settings.sticky %} site-header--sticky{% endif %}{% if transparent_enabled %} site-header--transparent{% endif %} site-header--logo-{{ section.settings.logo_position }}"
  style="--header-bg: {{ section.settings.background }}; --header-fg: {{ section.settings.foreground }}; --header-fg-transparent: {{ section.settings.transparent_foreground }}; --logo-width: {{ logo_width }}px; --logo-width-mobile: {{ logo_width_mobile }}px;"
  data-header
>
  <div class="site-header__inner">
    <button type="button" class="site-header__icon site-header__menu-toggle" aria-controls="MenuDrawer" aria-expanded="false" data-menu-open>
      {% render 'icon', name: 'menu' %}
      <span class="visually-hidden">{{ 'header.menu' | t }}</span>
    </button>

    <div class="site-header__logo">
      <a href="{{ routes.root_url }}" class="site-header__logo-link">
        {%- if logo -%}
          {{
            logo
            | image_url: width: 600
            | image_tag: class: 'site-header__logo-image site-header__logo-default', widths: '150, 300, 450, 600', sizes: logo_sizes, alt: shop.name, loading: 'eager'
          }}
        {%- else -%}
          <span class="site-header__logo-text site-header__logo-default">{{ shop.name }}</span>
        {%- endif -%}
        {%- if logo_transparent -%}
          {{
            logo_transparent
            | image_url: width: 600
            | image_tag: class: 'site-header__logo-image site-header__logo-transparent', widths: '150, 300, 450, 600', sizes: logo_sizes, alt: shop.name, loading: 'eager'
          }}
        {%- endif -%}
      </a>
    </div>

    <nav class="site-header__nav" aria-label="{{ 'header.main_navigation' | t }}">
      <ul class="site-nav" role="list">
        {%- for link in menu.links -%}
          {%- liquid
            assign mega = nil
            assign link_handle = link.title | handleize
            for block in section.blocks
              assign block_handle = block.settings.menu_item | handleize
              if block_handle == link_handle
                assign mega = block
                break
              endif
            endfor

            assign has_panel = false
            if link.links != blank or mega
              assign has_panel = true
            endif
            assign panel_id = 'MegaMenu-' | append: section.id | append: '-' | append: forloop.index
          -%}
          <li class="site-nav__item{% if has_panel %} site-nav__item--has-panel{% endif %}">
            <a
              href="{{ link.url }}"
              class="site-nav__link"
              {% if link.active or link.child_active %}
                aria-current="page"
              {% endif %}
            >
              {{- link.title -}}
            </a>

            {%- if has_panel -%}
              <button type="button" class="site-nav__toggle" aria-expanded="false" aria-controls="{{ panel_id }}">
                {% render 'icon', name: 'chevron-down' %}
                <span class="visually-hidden">{{ 'header.open_submenu' | t: title: link.title }}</span>
              </button>
              {% render 'mega-menu', link: link, block: mega, panel_id: panel_id, tab_products: section.settings.tab_products %}
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <div class="site-header__utils">
      <details class="header-search">
        <summary class="site-header__util">
          <span class="site-header__util-text">{{ 'header.search' | t }}</span>
          <span class="site-header__util-icon">{% render 'icon', name: 'search' %}</span>
          <span class="visually-hidden">{{ 'header.search' | t }}</span>
        </summary>
        <div class="header-search__panel">
          <form action="{{ routes.search_url }}" method="get" role="search" class="header-search__form">
            <label for="HeaderSearch-{{ section.id }}" class="visually-hidden">{{ 'search.placeholder' | t }}</label>
            <input
              id="HeaderSearch-{{ section.id }}"
              type="search"
              name="q"
              class="header-search__input"
              placeholder="{{ 'search.placeholder' | t }}"
              autocomplete="off"
            >
            <input type="hidden" name="type" value="product">
            <button type="submit" class="site-header__icon">
              {% render 'icon', name: 'arrow-right' %}
              <span class="visually-hidden">{{ 'search.submit' | t }}</span>
            </button>
          </form>
        </div>
      </details>

      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="site-header__util site-header__util--account">
          <span class="site-header__util-text">{{ 'header.account' | t }}</span>
          <span class="site-header__util-icon">{% render 'icon', name: 'account' %}</span>
          <span class="visually-hidden">{{ 'header.account' | t }}</span>
        </a>
      {%- endif -%}

      <a href="{{ routes.cart_url }}" class="site-header__util" data-cart-open>
        <span class="site-header__util-text">
          {{- 'header.cart' | t }} (<span data-cart-count>{{ cart.item_count }}</span>)
        </span>
        <span class="site-header__util-icon site-header__cart-icon">
          {% render 'icon', name: 'bag' %}
          <span class="site-header__cart-bubble" data-cart-count>{{ cart.item_count }}</span>
        </span>
        <span class="visually-hidden">{{ 'header.cart' | t }}</span>
      </a>
    </div>
  </div>
</header>

<dialog id="MenuDrawer" class="menu-drawer" aria-label="{{ 'header.menu' | t }}" scroll-lock>
  <div class="menu-drawer__header">
    {%- if logo -%}
      {{ logo | image_url: width: 300 | image_tag: class: 'menu-drawer__logo', widths: '150, 300', sizes: '120px', alt: shop.name, loading: 'lazy' }}
    {%- else -%}
      <span class="site-header__logo-text">{{ shop.name }}</span>
    {%- endif -%}
    <button type="button" class="site-header__icon" data-menu-close>
      {% render 'icon', name: 'close' %}
      <span class="visually-hidden">{{ 'general.close' | t }}</span>
    </button>
  </div>
  <nav class="menu-drawer__nav" aria-label="{{ 'header.main_navigation' | t }}">
    <ul class="menu-drawer__list" role="list">
      {%- for link in menu.links -%}
        {%- liquid
          assign mega = nil
          assign link_handle = link.title | handleize
          for block in section.blocks
            assign block_handle = block.settings.menu_item | handleize
            if block_handle == link_handle
              assign mega = block
              break
            endif
          endfor
        -%}
        <li>
          {%- if link.links != blank -%}
            <details class="menu-drawer__details">
              <summary class="menu-drawer__item">
                {{ link.title }}
                {% render 'icon', name: 'plus' %}
              </summary>
              <div class="menu-drawer__submenu">
                <ul role="list">
                  {%- for child in link.links -%}
                    <li>
                      {%- if child.links != blank -%}
                        <details class="menu-drawer__details menu-drawer__details--nested">
                          <summary class="menu-drawer__subitem">
                            {{ child.title }}
                            {% render 'icon', name: 'chevron-down' %}
                          </summary>
                          <ul class="menu-drawer__grandchildren" role="list">
                            {%- for grandchild in child.links -%}
                              <li><a href="{{ grandchild.url }}">{{ grandchild.title }}</a></li>
                            {%- endfor -%}
                            <li><a href="{{ child.url }}" class="menu-drawer__view-all">{{ 'header.view_all' | t }}</a></li>
                          </ul>
                        </details>
                      {%- else -%}
                        <a href="{{ child.url }}" class="menu-drawer__subitem">{{ child.title }}</a>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                  <li><a href="{{ link.url }}" class="menu-drawer__view-all">{{ 'header.view_all_in' | t: title: link.title }}</a></li>
                </ul>

                {%- if mega and mega.settings.featured == 'promos' -%}
                  <div class="menu-drawer__promos">
                    {%- for i in (1..2) -%}
                      {%- liquid
                        assign image_key = 'promo_' | append: i | append: '_image'
                        assign heading_key = 'promo_' | append: i | append: '_heading'
                        assign link_key = 'promo_' | append: i | append: '_link'
                        assign promo_image = mega.settings[image_key]
                        assign promo_heading = mega.settings[heading_key]
                        assign promo_link = mega.settings[link_key] | default: link.url
                      -%}
                      {%- if promo_image != blank -%}
                        <a href="{{ promo_link }}" class="menu-drawer__promo">
                          {{ promo_image | image_url: width: 500 | image_tag: widths: '250, 500', sizes: '45vw', loading: 'lazy', alt: promo_heading }}
                          {%- if promo_heading != blank -%}
                            <span>{{ promo_heading }}</span>
                          {%- endif -%}
                        </a>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                {%- endif -%}
              </div>
            </details>
          {%- else -%}
            <a href="{{ link.url }}" class="menu-drawer__item">{{ link.title }}</a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </nav>
  <div class="menu-drawer__footer">
    {%- if shop.customer_accounts_enabled -%}
      <a href="{{ routes.account_url }}">{% render 'icon', name: 'account' %}{{ 'header.account' | t }}</a>
    {%- endif -%}
    {%- if settings.social_instagram != blank -%}
      <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener">{% render 'icon', name: 'instagram' %}Instagram</a>
    {%- endif -%}
  </div>
</dialog>

{% javascript %}
  (() => {
    if (window.__sweetHeader) return;
    window.__sweetHeader = true;

    let current = null;
    let timer;

    const setOpen = (item, open) => {
      item.classList.toggle('is-open', open);
      item.querySelector(':scope > .site-nav__toggle')?.setAttribute('aria-expanded', String(open));
    };

    const openItem = (item) => {
      if (current && current !== item) setOpen(current, false);
      setOpen(item, true);
      current = item;
    };

    const closeItem = (item) => {
      if (!item) return;
      setOpen(item, false);
      if (current === item) current = null;
    };

    const panelItem = (target) => target?.closest?.('.site-nav__item--has-panel');
    const desktop = () => window.matchMedia('(min-width: 990px)').matches;

    document.addEventListener('mouseover', (event) => {
      const item = panelItem(event.target);
      if (!item || item.contains(event.relatedTarget) || !desktop()) return;
      clearTimeout(timer);
      timer = setTimeout(() => openItem(item), current ? 0 : 90);
    });

    document.addEventListener('mouseout', (event) => {
      const item = panelItem(event.target);
      if (!item || item.contains(event.relatedTarget)) return;
      clearTimeout(timer);
      timer = setTimeout(() => closeItem(item), 180);
    });

    document.addEventListener('click', (event) => {
      const toggle = event.target.closest('.site-nav__toggle');
      if (toggle) {
        const item = panelItem(toggle);
        item.classList.contains('is-open') ? closeItem(item) : openItem(item);
        return;
      }
      if (current && !current.contains(event.target)) closeItem(current);

      const search = document.querySelector('.header-search[open]');
      if (search && !search.contains(event.target)) search.removeAttribute('open');
    });

    document.addEventListener('focusout', (event) => {
      const item = panelItem(event.target);
      if (item && !item.contains(event.relatedTarget)) closeItem(item);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !current) return;
      const toggle = current.querySelector(':scope > .site-nav__toggle');
      closeItem(current);
      toggle?.focus();
    });

    document.addEventListener('shopify:block:select', (event) => {
      const panel = document.querySelector(`.mega-menu[data-block-id="${event.detail.blockId}"]`);
      if (panel) openItem(panelItem(panel));
    });

    document.addEventListener('shopify:block:deselect', (event) => {
      const panel = document.querySelector(`.mega-menu[data-block-id="${event.detail.blockId}"]`);
      if (panel) closeItem(panelItem(panel));
    });

    const onScroll = () => {
      document.querySelector('[data-header]')?.classList.toggle('is-solid', window.scrollY > 10);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    document.addEventListener('toggle', (event) => {
      if (event.target.matches?.('.header-search') && event.target.open) {
        event.target.querySelector('input[type="search"]')?.focus();
      }
    }, true);

    document.addEventListener('click', (event) => {
      const drawer = document.getElementById('MenuDrawer');
      if (!drawer) return;
      const toggle = event.target.closest('[data-menu-open]');
      if (toggle) {
        drawer.classList.remove('is-open');
        drawer.showModal();
        toggle.setAttribute('aria-expanded', 'true');
        requestAnimationFrame(() => drawer.classList.add('is-open'));
        return;
      }
      if (drawer.open && (event.target === drawer || event.target.closest('[data-menu-close]'))) {
        drawer.classList.remove('is-open');
        document.querySelector('[data-menu-open]')?.setAttribute('aria-expanded', 'false');
        setTimeout(() => drawer.close(), 250);
      }
    });
  })();
{% endjavascript %}

{% stylesheet %}
  .section-header {
    margin-top: 1rem;
  }

  .shopify-section-group-header-group:has(.site-header--sticky) {
    position: sticky;
    top: 0.5rem;
    z-index: 20;
  }

  .site-header {
    position: relative;
    z-index: 20;
    border-radius: var(--radius);
    background: var(--header-bg);
    color: var(--header-fg);
    transition: background-color 0.3s var(--ease), color 0.3s var(--ease), border-radius 0.2s var(--ease);
  }

  .site-header:has(.site-nav__item.is-open, .header-search[open]) {
    border-radius: var(--radius) var(--radius) 0 0;
    transition-delay: 0s;
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    grid-template-areas: 'nav logo utils';
    align-items: center;
    gap: 1rem;
    height: var(--header-height);
    padding-inline: clamp(1rem, 0.5rem + 1.5vw, 2rem);
  }

  .site-header--logo-left .site-header__inner {
    grid-template-columns: auto 1fr auto;
    grid-template-areas: 'logo nav utils';
    gap: 3rem;
  }

  .site-header__logo {
    grid-area: logo;
  }

  .site-header__logo-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .site-header__logo-image {
    width: var(--logo-width);
    height: auto;
    max-height: calc(var(--header-height) - 1.5rem);
    object-fit: contain;
  }

  .site-header__logo-transparent {
    display: none;
  }

  .site-header__logo-text {
    display: block;
    font-family: var(--font-display--family);
    font-weight: var(--font-display--weight);
    font-size: clamp(1.75rem, 1.2rem + 1.6vw, 2.75rem);
    line-height: 1;
    letter-spacing: -0.03em;
    text-transform: lowercase;
    color: inherit;
  }

  .site-header__nav {
    grid-area: nav;
    height: 100%;
  }

  .site-nav {
    display: flex;
    align-items: stretch;
    gap: 3rem;
    height: 100%;
    padding: 0;
    list-style: none;
  }

  .site-nav__item {
    display: flex;
    align-items: center;
  }

  .site-nav__link,
  .site-header__util {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    height: 100%;
    font-size: 1rem;
    font-weight: var(--font-bold--weight);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    list-style: none;
    white-space: nowrap;
  }

  .site-nav__link:hover,
  .site-nav__item.is-open > .site-nav__link,
  .site-header__util:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }

  .site-nav__toggle {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
    background: none;
    color: inherit;
  }

  .site-nav__toggle:focus-visible {
    position: static;
    width: 1.25rem;
    height: 1.25rem;
    margin: 0 0 0 0.25rem;
    overflow: visible;
    clip: auto;
    display: grid;
    place-items: center;
  }

  .site-nav__toggle .icon {
    width: 0.625rem;
  }

  .site-header__util::-webkit-details-marker {
    display: none;
  }

  .site-header__utils {
    grid-area: utils;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 3rem;
    height: 100%;
  }

  .site-header__util-icon {
    display: none;
  }

  .site-header__icon {
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  .site-header__menu-toggle {
    display: none;
    grid-area: nav;
    justify-self: start;
  }

  .site-header__cart-icon {
    position: relative;
  }

  .site-header__cart-bubble {
    position: absolute;
    top: 0.15rem;
    right: 0.2rem;
    font-size: 0.6875rem;
    font-weight: var(--font-bold--weight);
    line-height: 1;
    letter-spacing: 0;
  }

  .header-search {
    height: 100%;
    display: flex;
  }

  .header-search__panel {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    padding: 0.5rem clamp(1rem, 0.5rem + 1.5vw, 2rem) 2rem;
    border-radius: 0 0 var(--radius) var(--radius);
    background: var(--header-bg);
    animation: mega-fade 0.3s var(--ease);
  }

  .header-search__form {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: min(40rem, 100%);
    margin-inline: auto;
    padding-inline: 1rem 0.25rem;
    border-radius: var(--radius-small);
    background: var(--color-background);
    color: var(--color-heading);
  }

  .header-search__input {
    flex: 1;
    min-height: 3.25rem;
    border: 0;
    background: none;
    color: var(--color-heading);
    font-size: 1rem;
    outline: none;
  }

  .menu-drawer {
    width: min(26rem, 92vw);
    max-width: none;
    height: calc(100% - 1rem);
    max-height: none;
    margin: 0.5rem;
    padding: 0;
    border: 0;
    border-radius: var(--radius);
    background: var(--color-surface);
    display: flex;
    flex-direction: column;
    transform: translateX(calc(-100% - 1rem));
    transition: transform 0.35s var(--ease);
  }

  .menu-drawer:not([open]) {
    display: none;
  }

  .menu-drawer.is-open {
    transform: none;
  }

  .menu-drawer::backdrop {
    background: var(--color-overlay);
  }

  .menu-drawer__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: var(--header-height);
    padding: 0 1rem 0 1.25rem;
    color: var(--color-heading);
  }

  .menu-drawer__logo {
    width: 7.5rem;
    height: auto;
  }

  .menu-drawer__nav {
    flex: 1;
    overflow-y: auto;
    padding: 0 1.25rem 1.5rem;
    color: var(--color-heading);
  }

  .menu-drawer__nav ul {
    padding: 0;
    list-style: none;
  }

  .menu-drawer__item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-block: 1rem;
    border-bottom: 1px solid var(--color-border);
    font-size: 1.125rem;
    font-weight: var(--font-bold--weight);
    text-decoration: none;
    text-transform: uppercase;
    cursor: pointer;
    list-style: none;
  }

  .menu-drawer__details > summary::-webkit-details-marker {
    display: none;
  }

  .menu-drawer__details > summary .icon {
    transition: transform 0.25s var(--ease);
  }

  .menu-drawer__details[open] > .menu-drawer__item .icon {
    transform: rotate(45deg);
  }

  .menu-drawer__details--nested[open] > summary .icon {
    transform: rotate(180deg);
  }

  .menu-drawer__submenu {
    display: grid;
    gap: 1.25rem;
    padding: 0.75rem 0 1.5rem;
    border-bottom: 1px solid var(--color-border);
    animation: mega-fade 0.3s var(--ease);
  }

  .menu-drawer__subitem {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-block: 0.5rem;
    font-size: 1rem;
    text-decoration: none;
    cursor: pointer;
    list-style: none;
  }

  .menu-drawer__grandchildren {
    display: grid;
    gap: 0.2rem;
    padding: 0 0 0.5rem 1rem !important;
    border-left: 1px solid var(--color-border);
  }

  .menu-drawer__grandchildren a {
    display: block;
    padding-block: 0.35rem;
    text-decoration: none;
  }

  .menu-drawer__view-all {
    display: inline-block;
    margin-top: 0.5rem;
    font-weight: var(--font-bold--weight);
    text-transform: uppercase;
  }

  .menu-drawer__promos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .menu-drawer__promo {
    display: grid;
    gap: 0.5rem;
    font-weight: var(--font-bold--weight);
    text-transform: uppercase;
    text-decoration: none;
  }

  .menu-drawer__promo img {
    aspect-ratio: 4 / 5;
    width: 100%;
    object-fit: cover;
    border-radius: var(--radius-small);
    background: var(--color-card);
  }

  .menu-drawer__footer {
    display: flex;
    gap: 1.5rem;
    padding: 1.25rem;
    border-top: 1px solid var(--color-border);
    font-weight: var(--font-bold--weight);
    text-transform: uppercase;
  }

  .menu-drawer__footer a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-heading);
    text-decoration: none;
  }

  @media (max-width: 1199px) {
    .site-nav,
    .site-header__utils {
      gap: 1.75rem;
    }
  }

  @media (max-width: 989px) {
    .site-header__inner,
    .site-header--logo-left .site-header__inner {
      grid-template-columns: 1fr auto 1fr;
      grid-template-areas: 'nav logo utils';
      gap: 0.5rem;
      padding-inline: 0.5rem;
    }

    .site-header__nav {
      display: none;
    }

    .site-header__menu-toggle {
      display: inline-grid;
    }

    .site-header__logo-image {
      width: var(--logo-width-mobile);
    }

    .site-header__util-text {
      display: none;
    }

    .site-header__util-icon {
      display: inline-grid;
      place-items: center;
      width: 2.5rem;
      height: 2.5rem;
    }

    .site-header__util--account {
      display: none;
    }

    .site-header__utils {
      gap: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Cabeçalho",
  "class": "section-header",
  "max_blocks": 8,
  "settings": [
    {
      "type": "header",
      "content": "Logos"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Usado no cabeçalho com fundo (normalmente a versão verde)."
    },
    {
      "type": "image_picker",
      "id": "logo_transparent",
      "label": "Logo para cabeçalho transparente",
      "info": "Usado sobre o banner (normalmente a versão branca). Se vazio, usa o logo principal."
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 60,
      "max": 300,
      "step": 5,
      "unit": "px",
      "label": "Largura do logo",
      "default": 136
    },
    {
      "type": "select",
      "id": "logo_position",
      "label": "Posição do logo",
      "options": [
        { "value": "center", "label": "Centro" },
        { "value": "left", "label": "Esquerda" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Cabeçalho transparente"
    },
    {
      "type": "select",
      "id": "transparent_mode",
      "label": "Deixar transparente",
      "options": [
        { "value": "off", "label": "Nunca" },
        { "value": "auto", "label": "Em páginas que começam com banner" },
        { "value": "home", "label": "Somente na página inicial" }
      ],
      "default": "auto",
      "info": "Fica sobre o banner e ganha fundo ao rolar a página ou passar o mouse."
    },
    {
      "type": "color",
      "id": "transparent_foreground",
      "label": "Cor do texto quando transparente",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Cores e comportamento"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Fundo",
      "default": "#F3F2E7"
    },
    {
      "type": "color",
      "id": "foreground",
      "label": "Texto",
      "default": "#244930"
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Fixar no topo ao rolar",
      "default": true
    },
    {
      "type": "header",
      "content": "Menu"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu",
      "info": "Itens com submenu abrem um mega menu. Adicione blocos \"Mega menu\" para personalizar cada um."
    },
    {
      "type": "range",
      "id": "tab_products",
      "min": 4,
      "max": 12,
      "step": 1,
      "label": "Produtos por aba (layout em abas)",
      "default": 8
    }
  ],
  "blocks": [
    {
      "type": "mega_menu",
      "name": "Mega menu",
      "settings": [
        {
          "type": "text",
          "id": "menu_item",
          "label": "Item do menu",
          "info": "Nome do item do menu principal onde o mega menu aparece. Ex.: Loja",
          "default": "Loja"
        },
        {
          "type": "select",
          "id": "layout",
          "label": "Layout",
          "options": [
            { "value": "tabs", "label": "Abas com produtos (igual à Rhode)" },
            { "value": "columns", "label": "Colunas de links" }
          ],
          "default": "tabs",
          "info": "Colunas: cada subitem vira uma coluna com seus links. Abas: passe o mouse nas categorias para ver os produtos."
        },
        {
          "type": "select",
          "id": "featured",
          "label": "Destaque ao lado dos links (layout colunas)",
          "options": [
            { "value": "promos", "label": "Imagens promocionais" },
            { "value": "products", "label": "Produtos de uma coleção" },
            { "value": "none", "label": "Nenhum" }
          ],
          "default": "promos"
        },
        {
          "type": "checkbox",
          "id": "show_footer",
          "label": "Mostrar botão \"ver tudo\"",
          "default": true
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Texto do botão",
          "info": "Se vazio, usa \"Ver\" + nome do item.",
          "default": "Ver tudo"
        },
        {
          "type": "header",
          "content": "Produtos em destaque"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Coleção"
        },
        {
          "type": "range",
          "id": "products_limit",
          "min": 2,
          "max": 4,
          "step": 1,
          "label": "Quantidade de produtos",
          "default": 3
        },
        {
          "type": "header",
          "content": "Imagem promocional 1"
        },
        {
          "type": "image_picker",
          "id": "promo_1_image",
          "label": "Imagem"
        },
        {
          "type": "text",
          "id": "promo_1_heading",
          "label": "Título",
          "default": "Lançamentos"
        },
        {
          "type": "text",
          "id": "promo_1_text",
          "label": "Texto",
          "default": "Os novos queridinhos"
        },
        {
          "type": "url",
          "id": "promo_1_link",
          "label": "Link"
        },
        {
          "type": "header",
          "content": "Imagem promocional 2"
        },
        {
          "type": "image_picker",
          "id": "promo_2_image",
          "label": "Imagem"
        },
        {
          "type": "text",
          "id": "promo_2_heading",
          "label": "Título",
          "default": "Kits"
        },
        {
          "type": "text",
          "id": "promo_2_text",
          "label": "Texto",
          "default": "Presentes prontos"
        },
        {
          "type": "url",
          "id": "promo_2_link",
          "label": "Link"
        }
      ]
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
