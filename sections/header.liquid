{%- liquid
  assign menu = section.settings.menu
  assign logo_width_mobile = settings.logo_width | times: 0.75 | round
-%}

<header
  class="site-header full-width{% if section.settings.sticky %} site-header--sticky{% endif %} site-header--logo-{{ section.settings.logo_position }}"
  style="--header-bg: {{ section.settings.background }}; --header-fg: {{ section.settings.foreground }}; --logo-width-mobile: {{ logo_width_mobile }}px;"
>
  <div class="site-header__inner">
    <button type="button" class="site-header__icon site-header__menu-toggle" aria-controls="MenuDrawer" aria-expanded="false" data-menu-open>
      {% render 'icon', name: 'menu' %}
      <span class="visually-hidden">{{ 'header.menu' | t }}</span>
    </button>

    <div class="site-header__logo">
      <a href="{{ routes.root_url }}" class="site-header__logo-link">
        {%- if settings.logo -%}
          {{
            settings.logo
            | image_url: width: 600
            | image_tag: class: 'site-header__logo-image', widths: '150, 300, 450, 600', sizes: '(min-width: 750px) var(--logo-width), var(--logo-width-mobile)', alt: shop.name, loading: 'eager'
          }}
        {%- else -%}
          <span class="site-header__logo-text">{{ shop.name }}</span>
        {%- endif -%}
      </a>
    </div>

    <nav class="site-header__nav" aria-label="{{ 'header.main_navigation' | t }}">
      <ul class="site-nav" role="list">
        {%- for link in menu.links -%}
          <li class="site-nav__item{% if link.links != blank %} site-nav__item--has-panel{% endif %}">
            <a
              href="{{ link.url }}"
              class="site-nav__link"
              {% if link.active %}
                aria-current="page"
              {% endif %}
            >
              {{- link.title -}}
            </a>

            {%- if link.links != blank -%}
              <div class="mega-menu">
                <div class="mega-menu__inner">
                  <div class="mega-menu__tabs" role="tablist" aria-orientation="vertical" data-tab-hover>
                    {%- for child in link.links -%}
                      <a
                        href="{{ child.url }}"
                        role="tab"
                        id="MegaTab-{{ section.id }}-{{ forloop.parentloop.index }}-{{ forloop.index }}"
                        aria-controls="MegaPanel-{{ section.id }}-{{ forloop.parentloop.index }}-{{ forloop.index }}"
                        aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                        class="mega-menu__tab"
                      >
                        {{- child.title -}}
                      </a>
                    {%- endfor -%}
                  </div>

                  {%- for child in link.links -%}
                    <div
                      class="mega-menu__panel"
                      role="tabpanel"
                      id="MegaPanel-{{ section.id }}-{{ forloop.parentloop.index }}-{{ forloop.index }}"
                      aria-labelledby="MegaTab-{{ section.id }}-{{ forloop.parentloop.index }}-{{ forloop.index }}"
                      {% unless forloop.first %}
                        hidden
                      {% endunless %}
                    >
                      {%- if child.type == 'collection_link' and child.object.products_count > 0 -%}
                        <ul class="mega-menu__products" role="list">
                          {%- for product in child.object.products limit: section.settings.mega_menu_products -%}
                            <li>
                              {% render 'product-card', product: product, sizes: '(min-width: 990px) 16vw, 25vw' %}
                            </li>
                          {%- endfor -%}
                        </ul>
                        <a href="{{ child.url }}" class="mega-menu__all">
                          {{- 'header.shop_title' | t: title: child.title -}}
                        </a>
                      {%- elsif child.links != blank -%}
                        <ul class="mega-menu__links" role="list">
                          {%- for grandchild in child.links -%}
                            <li><a href="{{ grandchild.url }}">{{ grandchild.title }}</a></li>
                          {%- endfor -%}
                        </ul>
                      {%- else -%}
                        <a href="{{ child.url }}" class="mega-menu__all">
                          {{- 'header.shop_title' | t: title: child.title -}}
                        </a>
                      {%- endif -%}
                    </div>
                  {%- endfor -%}
                </div>
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <div class="site-header__utils">
      <details class="header-search">
        <summary class="site-header__util">
          <span class="site-header__util-text">{{ 'header.search' | t }}</span>
          <span class="site-header__util-icon">{% render 'icon', name: 'search' %}</span>
          <span class="visually-hidden">{{ 'header.search' | t }}</span>
        </summary>
        <div class="header-search__panel">
          <form action="{{ routes.search_url }}" method="get" role="search" class="header-search__form">
            <label for="HeaderSearch-{{ section.id }}" class="visually-hidden">{{ 'search.placeholder' | t }}</label>
            <input
              id="HeaderSearch-{{ section.id }}"
              type="search"
              name="q"
              class="header-search__input"
              placeholder="{{ 'search.placeholder' | t }}"
              autocomplete="off"
            >
            <input type="hidden" name="type" value="product">
            <button type="submit" class="site-header__icon">
              {% render 'icon', name: 'arrow-right' %}
              <span class="visually-hidden">{{ 'search.submit' | t }}</span>
            </button>
          </form>
        </div>
      </details>

      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="site-header__util site-header__util--account">
          <span class="site-header__util-text">{{ 'header.account' | t }}</span>
          <span class="site-header__util-icon">{% render 'icon', name: 'account' %}</span>
          <span class="visually-hidden">{{ 'header.account' | t }}</span>
        </a>
      {%- endif -%}

      <a href="{{ routes.cart_url }}" class="site-header__util" data-cart-open>
        <span class="site-header__util-text">
          {{- 'header.cart' | t }} (<span data-cart-count>{{ cart.item_count }}</span>)
        </span>
        <span class="site-header__util-icon site-header__cart-icon">
          {% render 'icon', name: 'bag' %}
          <span class="site-header__cart-bubble" data-cart-count>{{ cart.item_count }}</span>
        </span>
        <span class="visually-hidden">{{ 'header.cart' | t }}</span>
      </a>
    </div>
  </div>
</header>

<dialog id="MenuDrawer" class="menu-drawer" aria-label="{{ 'header.menu' | t }}" scroll-lock>
  <div class="menu-drawer__header">
    <span class="eyebrow">{{ 'header.menu' | t }}</span>
    <button type="button" class="site-header__icon" data-menu-close>
      {% render 'icon', name: 'close' %}
      <span class="visually-hidden">{{ 'general.close' | t }}</span>
    </button>
  </div>
  <nav class="menu-drawer__nav" aria-label="{{ 'header.main_navigation' | t }}">
    <ul role="list">
      {%- for link in menu.links -%}
        <li>
          {%- if link.links != blank -%}
            <details class="menu-drawer__details">
              <summary>
                {{ link.title }}
                {% render 'icon', name: 'plus' %}
              </summary>
              <ul role="list">
                <li><a href="{{ link.url }}">{{ 'header.view_all' | t }}</a></li>
                {%- for child in link.links -%}
                  <li><a href="{{ child.url }}">{{ child.title }}</a></li>
                {%- endfor -%}
              </ul>
            </details>
          {%- else -%}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </nav>
  <div class="menu-drawer__footer">
    {%- if shop.customer_accounts_enabled -%}
      <a href="{{ routes.account_url }}">{{ 'header.account' | t }}</a>
    {%- endif -%}
    {%- if settings.social_instagram != blank -%}
      <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener">Instagram</a>
    {%- endif -%}
  </div>
</dialog>

{% javascript %}
  (() => {
    const drawer = document.getElementById('MenuDrawer');
    if (!drawer) return;
    const toggle = document.querySelector('[data-menu-open]');
    const close = () => {
      drawer.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
      setTimeout(() => drawer.close(), 250);
    };
    toggle?.addEventListener('click', () => {
      drawer.showModal();
      toggle.setAttribute('aria-expanded', 'true');
      requestAnimationFrame(() => drawer.classList.add('is-open'));
    });
    drawer.addEventListener('click', (event) => {
      if (event.target === drawer || event.target.closest('[data-menu-close]')) close();
    });
    drawer.addEventListener('cancel', (event) => {
      event.preventDefault();
      close();
    });
    document.addEventListener('click', (event) => {
      const search = document.querySelector('.header-search[open]');
      if (search && !search.contains(event.target)) search.removeAttribute('open');
    });
    document.querySelector('.header-search')?.addEventListener('toggle', (event) => {
      if (event.target.open) event.target.querySelector('input[type="search"]')?.focus();
    });
  })();
{% endjavascript %}

{% stylesheet %}
  .site-header {
    position: relative;
    z-index: 20;
    background: var(--header-bg);
    color: var(--header-fg);
    border-bottom: 1px solid var(--color-border);
  }

  .shopify-section-group-header-group:has(.site-header--sticky) {
    position: sticky;
    top: 0;
    z-index: 20;
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    grid-template-areas: 'nav logo utils';
    align-items: center;
    gap: 1rem;
    width: min(var(--page-width), 100%);
    min-height: var(--header-height);
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }

  .site-header--logo-left .site-header__inner {
    grid-template-columns: auto 1fr auto;
    grid-template-areas: 'logo nav utils';
    gap: 2.5rem;
  }

  .site-header__logo {
    grid-area: logo;
  }

  .site-header__logo-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .site-header__logo-image {
    width: var(--logo-width);
    height: auto;
  }

  .site-header__logo-text {
    font-family: var(--font-heading--family);
    font-size: 1.5rem;
    letter-spacing: 0.04em;
    text-transform: lowercase;
    color: var(--header-fg);
  }

  .site-header__nav {
    grid-area: nav;
    height: 100%;
  }

  .site-nav {
    display: flex;
    align-items: stretch;
    gap: 1.75rem;
    height: 100%;
    padding: 0;
    list-style: none;
  }

  .site-nav__item {
    display: flex;
    align-items: center;
  }

  .site-nav__link,
  .site-header__util {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    height: 100%;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    list-style: none;
  }

  .site-header__util::-webkit-details-marker {
    display: none;
  }

  .site-nav__link:hover,
  .site-nav__link[aria-current],
  .site-header__util:hover {
    text-decoration: underline;
    text-underline-offset: 0.35em;
  }

  .site-header__utils {
    grid-area: utils;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 1.5rem;
    height: 100%;
  }

  .site-header__util-icon {
    display: none;
  }

  .site-header__icon {
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  .site-header__menu-toggle {
    display: none;
    grid-area: nav;
    justify-self: start;
  }

  .site-header__cart-icon {
    position: relative;
  }

  .site-header__cart-bubble {
    position: absolute;
    top: -0.35rem;
    right: -0.5rem;
    display: grid;
    place-items: center;
    min-width: 1rem;
    height: 1rem;
    padding-inline: 0.2rem;
    border-radius: 1rem;
    background: var(--color-primary);
    color: var(--color-primary-contrast);
    font-size: 0.5625rem;
    letter-spacing: 0;
  }

  .mega-menu {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--header-bg);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity 0.25s var(--ease), transform 0.25s var(--ease), visibility 0.25s;
  }

  .site-nav__item--has-panel:hover .mega-menu,
  .site-nav__item--has-panel:focus-within .mega-menu {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .mega-menu__inner {
    display: grid;
    grid-template-columns: 14rem 1fr;
    gap: 2.5rem;
    width: min(var(--page-width), 100%);
    margin-inline: auto;
    padding: 2rem var(--page-margin) 2.5rem;
    color: var(--color-foreground);
  }

  .mega-menu__tabs {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .mega-menu__tab {
    font-size: 1.125rem;
    color: var(--color-foreground);
    text-decoration: none;
  }

  .mega-menu__tab[aria-selected='true'] {
    color: var(--color-heading);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .mega-menu__panel {
    grid-column: 2;
    grid-row: 1;
  }

  .mega-menu__products {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1rem;
    padding: 0;
    list-style: none;
  }

  .mega-menu__all {
    display: inline-block;
    margin-top: 1.5rem;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-heading);
  }

  .mega-menu__links {
    display: grid;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
  }

  .mega-menu__links a {
    text-decoration: none;
    color: var(--color-heading);
  }

  .header-search {
    height: 100%;
    display: flex;
  }

  .header-search__panel {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--header-bg);
    border-bottom: 1px solid var(--color-border);
    padding: 1rem var(--page-margin);
  }

  .header-search__form {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: min(40rem, 100%);
    margin-inline: auto;
    border-bottom: 1px solid currentcolor;
  }

  .header-search__input {
    flex: 1;
    min-height: 2.75rem;
    border: 0;
    background: none;
    color: var(--color-heading);
    font-size: 1rem;
    outline: none;
  }

  .menu-drawer {
    width: min(26rem, 88vw);
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    display: flex;
    flex-direction: column;
    transform: translateX(-100%);
    transition: transform 0.25s var(--ease);
  }

  .menu-drawer:not([open]) {
    display: none;
  }

  .menu-drawer.is-open {
    transform: none;
  }

  .menu-drawer::backdrop {
    background: var(--color-overlay);
  }

  .menu-drawer__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem var(--page-margin);
    border-bottom: 1px solid var(--color-border);
    color: var(--color-heading);
  }

  .menu-drawer__nav {
    flex: 1;
    overflow-y: auto;
    padding: 1rem var(--page-margin);
  }

  .menu-drawer__nav ul {
    padding: 0;
    list-style: none;
  }

  .menu-drawer__nav > ul > li > a,
  .menu-drawer__details > summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--color-border);
    font-size: 1.125rem;
    color: var(--color-heading);
    text-decoration: none;
    text-transform: lowercase;
    cursor: pointer;
    list-style: none;
  }

  .menu-drawer__details > summary::-webkit-details-marker {
    display: none;
  }

  .menu-drawer__details[open] > summary .icon {
    transform: rotate(45deg);
  }

  .menu-drawer__details ul {
    padding: 0.5rem 0 0.75rem 0.75rem;
  }

  .menu-drawer__details ul a {
    display: block;
    padding-block: 0.4rem;
    text-decoration: none;
  }

  .menu-drawer__footer {
    display: flex;
    gap: 1.5rem;
    padding: 1.25rem var(--page-margin);
    background: var(--color-surface);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .menu-drawer__footer a {
    color: var(--color-heading);
    text-decoration: none;
  }

  @media (max-width: 989px) {
    .site-header__inner,
    .site-header--logo-left .site-header__inner {
      grid-template-columns: 1fr auto 1fr;
      grid-template-areas: 'nav logo utils';
      gap: 0.5rem;
    }

    .site-header__nav {
      display: none;
    }

    .site-header__menu-toggle {
      display: inline-grid;
    }

    .site-header__logo-image {
      width: var(--logo-width-mobile);
    }

    .site-header__util-text {
      display: none;
    }

    .site-header__util-icon {
      display: inline-grid;
      place-items: center;
      width: 2.5rem;
      height: 2.5rem;
    }

    .site-header__util--account {
      display: none;
    }

    .site-header__utils {
      gap: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Cabeçalho",
  "class": "section-header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu",
      "info": "Itens com submenus abrem um mega menu. Submenus que apontam para coleções mostram os produtos."
    },
    {
      "type": "range",
      "id": "mega_menu_products",
      "min": 3,
      "max": 5,
      "step": 1,
      "label": "Produtos por aba no mega menu",
      "default": 5
    },
    {
      "type": "select",
      "id": "logo_position",
      "label": "Posição do logo",
      "options": [
        { "value": "center", "label": "Centro" },
        { "value": "left", "label": "Esquerda" }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Fixar no topo ao rolar",
      "default": true
    },
    {
      "type": "color",
      "id": "background",
      "label": "Fundo",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "foreground",
      "label": "Texto",
      "default": "#244930"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
