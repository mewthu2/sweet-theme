<div
  class="image-with-text full-width image-with-text--{{ section.settings.layout }}"
  style="--iwt-bg: {{ section.settings.background }};"
>
  <div class="image-with-text__media">
    {%- if section.settings.image -%}
      {{
        section.settings.image
        | image_url: width: 1800
        | image_tag: class: 'image-with-text__image', sizes: '(min-width: 750px) 50vw, 100vw', widths: '500, 800, 1100, 1400, 1800', loading: 'lazy'
      }}
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg image-with-text__image' }}
    {%- endif -%}
  </div>
  <div class="image-with-text__content">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2>{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="rte">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="button">
        {{- section.settings.button_label -}}
      </a>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .image-with-text {
    display: grid;
    background: var(--iwt-bg);
  }

  .image-with-text__media {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }

  .image-with-text__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .image-with-text__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 1.25rem;
    padding: clamp(2rem, 6vw, 6rem) var(--page-margin);
    max-width: 40rem;
  }

  @media (min-width: 750px) {
    .image-with-text {
      grid-template-columns: 1fr 1fr;
    }

    .image-with-text--image-right .image-with-text__media {
      order: 2;
    }

    .image-with-text__media {
      aspect-ratio: auto;
      min-height: 36rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Imagem com texto",
  "class": "section-image-with-text",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagem"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Posição da imagem",
      "options": [
        { "value": "image-left", "label": "Esquerda" },
        { "value": "image-right", "label": "Direita" }
      ],
      "default": "image-left"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Fundo",
      "default": "#EEEDBC"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Chamada pequena",
      "default": "nossa história"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Beleza leve, do seu jeito"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto",
      "default": "<p>Fórmulas pensadas para a pele jovem, com textura gostosa e resultado de verdade.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto do botão",
      "default": "Conheça"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link do botão"
    }
  ],
  "presets": [
    {
      "name": "Imagem com texto"
    }
  ]
}
{% endschema %}
