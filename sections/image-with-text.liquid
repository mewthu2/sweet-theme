<div class="image-with-text card image-with-text--{{ section.settings.layout }}" style="--iwt-bg: {{ section.settings.background }};">
  <div class="image-with-text__content">
    <div class="image-with-text__text">
      {%- if section.settings.heading != blank -%}
        <h2 class="image-with-text__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="rte image-with-text__body">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="button">
          {{- section.settings.button_label -}}
        </a>
      {%- endif -%}
    </div>
  </div>
  <div class="image-with-text__media">
    {%- if section.settings.image -%}
      {{
        section.settings.image
        | image_url: width: 1800
        | image_tag: class: 'image-with-text__image', sizes: '(min-width: 750px) 50vw, 100vw', widths: '500, 800, 1100, 1400, 1800', loading: 'lazy'
      }}
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg image-with-text__image' }}
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .image-with-text {
    display: grid;
    background: var(--iwt-bg);
  }

  .image-with-text__media {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
  }

  .image-with-text__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .image-with-text__content {
    display: flex;
    align-items: flex-end;
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }

  .image-with-text__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
    max-width: 28rem;
  }

  .image-with-text__heading {
    font-size: clamp(1.75rem, 1.4rem + 1vw, 2.25rem);
    line-height: 1.2;
  }

  .image-with-text__body {
    font-size: 1rem;
    line-height: 1.55;
  }

  @media (max-width: 749px) {
    .image-with-text__media {
      order: -1;
    }
  }

  @media (min-width: 750px) {
    .image-with-text {
      grid-template-columns: 1fr 1fr;
      min-height: min(88svh, 50rem);
    }

    .image-with-text__media {
      aspect-ratio: auto;
    }

    .image-with-text--image-left .image-with-text__media {
      order: -1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Imagem com texto",
  "class": "section-image-with-text",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagem"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Posição da imagem",
      "options": [
        { "value": "image-right", "label": "Direita" },
        { "value": "image-left", "label": "Esquerda" }
      ],
      "default": "image-right"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Fundo do texto",
      "default": "#F3F2E7"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "glow na medida"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto",
      "default": "<p>Fórmulas pensadas para a pele jovem, com textura gostosa e resultado de verdade. Um toque e pronto.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto do botão",
      "default": "Conheça"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link do botão"
    }
  ],
  "presets": [
    {
      "name": "Imagem com texto"
    }
  ]
}
{% endschema %}
