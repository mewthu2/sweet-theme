{%- liquid
  assign current = product.selected_or_first_available_variant
  assign subtitle = product.metafields.custom.subtitle.value
  assign form_id = 'ProductForm-' | append: section.id
  assign buy_label = 'products.buy_title' | t: title: product.title
-%}

<div class="product-main" data-product-section>
  <div class="product-gallery card" data-gallery>
    <ul class="product-gallery__track" role="list" data-gallery-track>
      {%- for media in product.media -%}
        <li class="product-gallery__item" id="Media-{{ section.id }}-{{ media.id }}" data-media-id="{{ media.id }}">
          {%- case media.media_type -%}
            {%- when 'image' -%}
              {%- liquid
                assign loading = 'lazy'
                if forloop.first
                  assign loading = 'eager'
                endif
              -%}
              {{
                media
                | image_url: width: 2000
                | image_tag: class: 'product-gallery__image', sizes: '(min-width: 990px) 55vw, 100vw', widths: '600, 900, 1200, 1600, 2000', loading: loading
              }}
            {%- when 'video', 'external_video' -%}
              {{ media | media_tag: image_size: '1500x', autoplay: true, loop: true, muted: true, controls: true, class: 'product-gallery__image' }}
            {%- else -%}
              {{ media | media_tag: class: 'product-gallery__image' }}
          {%- endcase -%}
        </li>
      {%- else -%}
        <li class="product-gallery__item">
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg product-gallery__image' }}
        </li>
      {%- endfor -%}
    </ul>

    {%- if product.media.size > 1 -%}
      <div class="product-gallery__thumbs" role="list">
        {%- for media in product.media -%}
          <button
            type="button"
            class="product-gallery__thumb"
            role="listitem"
            aria-label="{{ 'products.show_media' | t: index: forloop.index }}"
            aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
            data-gallery-thumb="{{ media.id }}"
          >
            {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  <div class="product-info card">
    <div class="product-info__top">
      {% render 'product-badge', product: product %}
    </div>

    <h1 class="product-info__title display">{{ product.title | downcase }}</h1>

    {%- if subtitle != blank -%}
      <p class="product-info__subtitle">{{ subtitle }}</p>
    {%- endif -%}

    {%- assign rating = product.metafields.reviews.rating.value -%}
    {%- if rating -%}
      {%- assign rating_percent = rating.rating | divided_by: rating.scale_max | times: 100 -%}
      <div class="product-card__rating">
        <span class="stars" style="--rating: {{ rating_percent }}%;" aria-hidden="true"></span>
        <span class="visually-hidden">{{ 'products.rating' | t: rating: rating.rating, max: rating.scale_max }}</span>
        {%- if product.metafields.reviews.rating_count.value -%}
          <span>({{ product.metafields.reviews.rating_count.value }})</span>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if product.description != blank and section.settings.show_description -%}
      <div class="product-info__description rte">{{ product.description }}</div>
    {%- endif -%}

    <div class="product-info__purchase">
      {%- unless product.has_only_default_variant -%}
        <variant-picker class="product-info__variants" data-form="{{ form_id }}">
          {%- for option in product.options_with_values -%}
            <fieldset class="variant-option">
              <legend class="variant-option__legend">
                {{ option.name }}: <strong data-selected-value>{{ option.selected_value }}</strong>
              </legend>
              <div class="variant-option__values">
                {%- for value in option.values -%}
                  {%- assign input_id = section.id | append: '-' | append: option.position | append: '-' | append: forloop.index -%}
                  <input
                    type="radio"
                    class="visually-hidden"
                    id="{{ input_id }}"
                    name="{{ section.id }}-{{ option.name | handleize }}"
                    value="{{ value.name | escape }}"
                    {% if value.selected %}
                      checked
                    {% endif %}
                  >
                  <label
                    for="{{ input_id }}"
                    class="variant-option__value{% if value.swatch %} variant-option__value--swatch{% endif %}{% unless value.available %} is-unavailable{% endunless %}"
                    title="{{ value.name | escape }}"
                    {% if value.swatch.image %}
                      style="--swatch: url({{ value.swatch.image | image_url: width: 80 }})"
                    {% elsif value.swatch.color %}
                      style="--swatch: {{ value.swatch.color }}"
                    {% endif %}
                  >
                    {%- if value.swatch -%}
                      <span class="visually-hidden">{{ value.name }}</span>
                    {%- else -%}
                      {{ value.name }}
                    {%- endif -%}
                  </label>
                {%- endfor -%}
              </div>
            </fieldset>
          {%- endfor -%}
          <script type="application/json">
            [
              {%- for variant in product.variants -%}
                {%- capture price_html -%}{% render 'price', product: product, variant: variant %}{%- endcapture -%}
                {
                  "id": {{ variant.id | json }},
                  "options": {{ variant.options | json }},
                  "available": {{ variant.available | json }},
                  "media_id": {{ variant.featured_media.id | json }},
                  "price": {{ variant.price | money | json }},
                  "price_html": {{ price_html | strip | json }}
                }{% unless forloop.last %},{% endunless %}
              {%- endfor -%}
            ]
          </script>
        </variant-picker>
      {%- endunless -%}

      {%- form 'product', product, id: form_id, class: 'product-form', data-product-form: '' -%}
        <input type="hidden" name="id" value="{{ current.id }}">
        <input type="hidden" name="quantity" value="1">
        <button
          type="submit"
          name="add"
          class="button button--solid button--full product-form__submit"
          data-add-button
          {% unless current.available %}
            disabled
          {% endunless %}
        >
          <span data-add-label data-available-label="{{ buy_label | escape }}">
            {%- if current.available -%}
              {{ buy_label }}
            {%- else -%}
              {{ 'products.sold_out' | t }}
            {%- endif -%}
          </span>
          <span aria-hidden="true">&nbsp;-&nbsp;</span>
          <strong data-button-price>{{ current.price | money }}</strong>
        </button>
        {%- if section.settings.show_dynamic_checkout -%}
          {{ form | payment_button }}
        {%- endif -%}
      {%- endform -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="product-info__accordions">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'text' -%}
              <div class="product-info__text rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
            {%- when 'collapsible' -%}
              {%- liquid
                assign content = block.settings.content
                if block.settings.page != blank
                  assign content = block.settings.page.content
                endif
              -%}
              {%- if content != blank -%}
                <details class="accordion" {{ block.shopify_attributes }}>
                  <summary class="accordion__summary">
                    {{ block.settings.heading }}
                    {% render 'icon', name: 'plus' %}
                  </summary>
                  <div class="accordion__content rte">{{ content }}</div>
                </details>
              {%- endif -%}
            {%- when 'complementary' -%}
              {%- if recommendations.performed == false or recommendations.products_count > 0 -%}
                <details class="accordion" open {{ block.shopify_attributes }}>
                  <summary class="accordion__summary">
                    {{ block.settings.heading }}
                    {% render 'icon', name: 'plus' %}
                  </summary>
                  <product-recommendations
                    class="product-info__complementary"
                    data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=3&intent=complementary"
                  >
                    {%- if recommendations.performed and recommendations.products_count > 0 -%}
                      <ul class="complementary-list" role="list">
                        {%- for item in recommendations.products -%}
                          <li class="complementary-item">
                            <a href="{{ item.url }}" class="complementary-item__media">
                              {{ item.featured_media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: item.title }}
                            </a>
                            <div>
                              <a href="{{ item.url }}" class="complementary-item__title product-title-case">{{ item.title }}</a>
                              <div>{{ item.price | money }}</div>
                            </div>
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}
                  </product-recommendations>
                </details>
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% javascript %}
  document.addEventListener('click', (event) => {
    const thumb = event.target.closest('[data-gallery-thumb]');
    if (!thumb) return;
    const gallery = thumb.closest('[data-gallery]');
    const item = gallery.querySelector(`[data-media-id="${thumb.dataset.galleryThumb}"]`);
    const track = gallery.querySelector('[data-gallery-track]');
    if (item && track) track.scrollTo({ left: item.offsetLeft, behavior: 'smooth' });
  });

  document.querySelectorAll('[data-gallery-track]').forEach((track) => {
    track.addEventListener(
      'scroll',
      () => {
        const index = Math.round(track.scrollLeft / track.clientWidth);
        const item = track.children[index];
        if (!item) return;
        track
          .closest('[data-gallery]')
          .querySelectorAll('[data-gallery-thumb]')
          .forEach((thumb) => thumb.setAttribute('aria-current', String(thumb.dataset.galleryThumb === item.dataset.mediaId)));
      },
      { passive: true }
    );
  });
{% endjavascript %}

{% stylesheet %}
  .product-main {
    display: grid;
    gap: clamp(0.5rem, 2vw, 1.9rem);
  }

  @media (min-width: 990px) {
    .product-main {
      grid-template-columns: minmax(0, 1.18fr) minmax(0, 1fr);
      align-items: start;
    }

    .product-info {
      position: sticky;
      top: calc(var(--header-height) + 1.5rem);
    }
  }

  .product-gallery {
    position: relative;
    background: var(--color-card);
  }

  .product-gallery__track {
    display: flex;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .product-gallery__track::-webkit-scrollbar {
    display: none;
  }

  .product-gallery__item {
    position: relative;
    flex: 0 0 100%;
    aspect-ratio: 4 / 5;
    scroll-snap-align: start;
  }

  @media (min-width: 990px) {
    .product-gallery__item {
      aspect-ratio: auto;
      height: calc(100svh - var(--header-height) - 5rem);
      min-height: 36rem;
    }
  }

  .product-gallery__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-gallery__thumbs {
    position: absolute;
    left: 1.9rem;
    bottom: 1.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-height: calc(100% - 3.8rem);
    overflow-y: auto;
    scrollbar-width: none;
  }

  .product-gallery__thumb {
    width: 3.25rem;
    height: 2.4rem;
    padding: 0;
    overflow: hidden;
    border: 1px solid transparent;
    border-radius: 0.6rem;
    background: var(--color-card);
    cursor: pointer;
    opacity: 0.75;
    transition: opacity 0.2s var(--ease), border-color 0.2s var(--ease);
  }

  .product-gallery__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-gallery__thumb[aria-current='true'],
  .product-gallery__thumb:hover {
    border-color: var(--color-background);
    opacity: 1;
  }

  @media (max-width: 749px) {
    .product-gallery__thumbs {
      flex-direction: row;
      left: 50%;
      bottom: 1rem;
      transform: translateX(-50%);
      gap: 0.4rem;
    }

    .product-gallery__thumb {
      width: 0.5rem;
      height: 0.5rem;
      border-radius: 50%;
      background: var(--color-background);
      opacity: 0.5;
    }

    .product-gallery__thumb img {
      display: none;
    }
  }

  .product-info {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: clamp(1.5rem, 1rem + 1.5vw, 1.9rem);
  }

  .product-info__top:empty {
    display: none;
  }

  .product-info__title {
    font-size: clamp(2.5rem, 1.8rem + 2.4vw, 3.75rem);
    color: var(--color-heading);
    line-height: 0.95;
  }

  .product-info__subtitle {
    margin-top: 0.25rem;
    font-weight: var(--font-bold--weight);
    text-transform: uppercase;
  }

  .product-info__description {
    line-height: 1.55;
  }

  .product-info__purchase {
    display: grid;
    gap: 1.25rem;
    padding-top: 1.9rem;
    border-top: 1px solid var(--color-border);
  }

  .variant-option {
    border: 0;
    padding: 0;
    margin: 0 0 1rem;
  }

  .variant-option:last-of-type {
    margin-bottom: 0;
  }

  .variant-option__legend {
    padding: 0;
    margin-bottom: 0.75rem;
  }

  .variant-option__legend strong {
    font-weight: var(--font-bold--weight);
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  .variant-option__values {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .variant-option__value {
    display: inline-grid;
    place-items: center;
    min-width: 2.75rem;
    height: 2.25rem;
    padding: 0 1.1rem;
    border: 1px solid var(--color-heading);
    border-radius: var(--style-border-radius-buttons);
    color: var(--color-heading);
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.2s var(--ease), color 0.2s var(--ease);
  }

  .variant-option__value--swatch {
    width: 2rem;
    min-width: 0;
    height: 2rem;
    padding: 0;
    border-color: transparent;
    border-radius: 50%;
    background: var(--swatch) center / cover;
    box-shadow: inset 0 0 0 2px var(--color-surface);
  }

  .variant-option__value.is-unavailable {
    opacity: 0.4;
  }

  input:checked + .variant-option__value {
    background: var(--color-heading);
    color: var(--color-surface);
  }

  input:checked + .variant-option__value--swatch {
    background: var(--swatch) center / cover;
    border-color: var(--color-heading);
  }

  input:focus-visible + .variant-option__value {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .product-form {
    display: grid;
    gap: 0.75rem;
  }

  .product-form__submit {
    min-height: 3rem;
    font-size: 1rem;
  }

  .shopify-payment-button__button {
    border-radius: var(--style-border-radius-buttons) !important;
    min-height: 3rem;
  }

  .product-info__accordions {
    display: grid;
  }

  .product-info__text {
    padding-bottom: 1rem;
  }

  .accordion {
    border-top: 1px solid var(--color-border);
  }

  .accordion__summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-block: 1.1rem;
    color: var(--color-heading);
    font-weight: var(--font-bold--weight);
    text-transform: uppercase;
    cursor: pointer;
    list-style: none;
  }

  .accordion__summary::-webkit-details-marker {
    display: none;
  }

  .accordion__summary .icon {
    transition: transform 0.2s var(--ease);
  }

  .accordion[open] .accordion__summary .icon {
    transform: rotate(45deg);
  }

  .accordion__content {
    padding-bottom: 1.25rem;
  }

  .complementary-list {
    display: grid;
    gap: 0.75rem;
    padding: 0 0 1.25rem;
    list-style: none;
  }

  .complementary-item {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: 1rem;
    align-items: center;
    padding: 0.5rem;
    border-radius: var(--radius-small);
    background: var(--color-background);
  }

  .complementary-item__media img {
    width: 4rem;
    height: 4rem;
    object-fit: contain;
    border-radius: 0.5rem;
    background: var(--color-card);
    mix-blend-mode: multiply;
  }

  .complementary-item__title {
    font-weight: var(--font-bold--weight);
    text-decoration: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Produto",
  "class": "section-product",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Mostrar descrição",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Mostrar botão de compra rápida",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Texto",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Texto",
          "default": "<p>Frete grátis acima de R$ 299</p>"
        }
      ]
    },
    {
      "type": "collapsible",
      "name": "Aba recolhível",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Título",
          "default": "Como usar"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Conteúdo"
        },
        {
          "type": "page",
          "id": "page",
          "label": "Conteúdo de uma página",
          "info": "Substitui o conteúdo acima."
        }
      ]
    },
    {
      "type": "complementary",
      "name": "Complete sua rotina",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Título",
          "default": "Complete sua rotina"
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
